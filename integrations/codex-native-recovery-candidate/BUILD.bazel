python_binary(
    name = "refresh_artifact",
    main = "//integrations/codex-upstream:refresh_artifact.py",
    srcs = ["//integrations/codex-upstream:patch_io.py"],
    args = [piece for name in _BASELINE_NEW_FILES + _RECOVERY_NEW_SCHEMA_FILES for piece in ["--new-file", name]],
)

# Explicit invocation until root stages and verifies this epoch's artifact.
python_test(
    name = "artifact_test",
    main = "//integrations/codex-owner-candidate:artifact_test.py",
    srcs = ["//integrations/codex-upstream:patch_io.py"],
    data = ["README.md", ":artifact_files"],
    args = ["--artifact-dir", "$(location README.md)"],
    tags = ["manual"],
)

host_python_binary(
    name = "restore_source",
    main = "//integrations/codex-upstream:restore_source.py",
    srcs = ["//integrations/codex-upstream:patch_io.py"],
    data = ["README.md", ":artifact_files", "@omux_host//:git", "@omux_host//:ca-bundle.crt"],
    args = ["--artifact-dir", "$(location README.md)", "--git", "$(location @omux_host//:git)", "--ca-file", "$(location @omux_host//:ca-bundle.crt)"],
)

# Original selection is bound to all164 prior changes and the pinned mirror.
# This target exports originals; it does not consume edited source bytes.
host_python_binary(
    name = "export_pristine_subset",
    main = "//integrations/codex-upstream:export_pristine_subset.py",
    srcs = ["//integrations/codex-upstream:restore_source.py", "//integrations/codex-upstream:patch_io.py"],
    data = ["//integrations/codex-owner-candidate:public_sources", "//integrations/codex-owner-candidate:README.md", "@omux_host//:git", "@omux_host//:ca-bundle.crt"],
    args = ["--artifact-dir", "$(location //integrations/codex-owner-candidate:README.md)", "--git", "$(location @omux_host//:git)", "--ca-file", "$(location @omux_host//:ca-bundle.crt)"],
)
