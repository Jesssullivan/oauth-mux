+        }
+        self.broker_local_only.load(Ordering::Acquire)
+    }
+
+    fn spawn_native_remote_task(
+        &self,
+        future: impl std::future::Future<Output = ()> + Send + 'static,
+    ) {
+        let mut tasks = self
+            .broker_remote_tasks
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if self.broker_local_only.load(Ordering::Acquire) {
+            return;
+        }
+        tasks.retain(|task| !task.is_finished());
+        tasks.push(tokio::spawn(future));
+    }
+
+    async fn native_remote_work<T>(
+        &self,
+        future: impl std::future::Future<Output = T>,
+    ) -> Option<T> {
+        let mut cancelled = self.broker_remote_cancel.subscribe();
+        let _admission = self.broker_remote_admission.read().await;
+        if self.broker_local_only.load(Ordering::Acquire) {
+            return None;
+        }
+        tokio::select! {
+            biased;
+            _ = cancelled.changed() => None,
+            result = future => Some(result),
+        }
+    }
