+pub fn prepare_registration(
+    thread_id: ThreadId,
+    socket: PathBuf,
+    capability_path: PathBuf,
+    binding_id: String,
+    operation_id: Option<String>,
+) -> std::io::Result<()> {
+    prepare_registration_inner(
+        thread_id,
+        socket,
+        capability_path,
+        binding_id,
+        operation_id,
+        false,
+    )
