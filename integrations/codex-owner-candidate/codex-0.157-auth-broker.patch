+        "custody_expires_at": 1704164705,
+        "observed_at": 1704164525,
+        "account_id": "synthetic-private-value",
+        "grant_id": "synthetic-private-value",
+        "provider_account_id": "synthetic-private-value",
+        "subject": "synthetic-private-value",
+        "email": "synthetic-private-value",
+        "access_token": "synthetic-private-value",
+        "tenant": "synthetic-private-value",
