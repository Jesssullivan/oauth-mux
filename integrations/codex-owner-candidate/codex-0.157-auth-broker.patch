+
+/// A process-wide, irreversible delivery fence shared by every client clone.
+/// Late broker attachment cannot safely attribute the existing native queue's
+/// events to a request-scoped account, so it stops that queue completely.
+pub(crate) struct NativeAnalyticsDelivery {
+    enabled: AtomicBool,
+    stop: watch::Sender<bool>,
+    stopped: watch::Sender<bool>,
+}
+
+struct NativeDeliveryWorkerExit<'a>(&'a NativeAnalyticsDelivery);
+
+impl Drop for NativeDeliveryWorkerExit<'_> {
+    fn drop(&mut self) {
+        self.0.enabled.store(false, Ordering::Release);
+        self.0.stopped.send_replace(true);
+    }
+}
+
+impl Default for NativeAnalyticsDelivery {
+    fn default() -> Self {
+        let (stop, _) = watch::channel(false);
+        let (stopped, _) = watch::channel(false);
+        Self {
+            enabled: AtomicBool::new(true),
+            stop,
+            stopped,
+        }
+    }
+}
+
+impl NativeAnalyticsDelivery {
+    fn is_enabled(&self) -> bool {
+        self.enabled.load(Ordering::Acquire)
+    }
+
+    async fn run_until_disabled(&self, worker: impl std::future::Future<Output = ()>) {
+        let _exit = NativeDeliveryWorkerExit(self);
+        let mut stop = self.stop.subscribe();
+        if self.is_enabled() {
+            tokio::select! {
+                biased;
+                _ = wait_for_delivery_signal(&mut stop) => {}
+                _ = worker => {}
+            }
+        } else {
+            drop(worker);
+        }
+    }
+
+    async fn disable_and_wait(&self) {
+        self.enabled.store(false, Ordering::Release);
+        self.stop.send_replace(true);
+        let mut stopped = self.stopped.subscribe();
+        wait_for_delivery_signal(&mut stopped).await;
+    }
+}
+
+async fn wait_for_delivery_signal(receiver: &mut watch::Receiver<bool>) {
+    while !*receiver.borrow_and_update() {
+        if receiver.changed().await.is_err() {
+            return;
+        }
+    }
 }
 
