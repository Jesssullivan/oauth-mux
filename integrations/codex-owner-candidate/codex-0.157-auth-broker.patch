+    /// Adoption permanently disables canonical-account plugin discovery for this process.
+    /// Existing local bundles remain available without borrowing native authentication.
+    pub fn enter_broker_local_only(&self) {
+        let tasks = self
+            .broker_remote_tasks
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if self.broker_local_only.swap(true, Ordering::AcqRel) {
+            return;
+        }
+        self.broker_remote_cancel.send_replace(true);
+        for task in tasks.iter() {
+            task.abort();
+        }
+        drop(tasks);
+        self.clear_cache();
+        self.clear_recommended_plugins_cache();
+        self.clear_remote_installed_plugins_cache();
+        *self
+            .remote_installed_plugins_cache_refresh_state
+            .write()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) =
+            RemoteInstalledPluginsCacheRefreshState::default();
+        *self
+            .remote_catalog_cache_refresh_state
+            .write()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) =
+            RemoteCatalogCacheRefreshState::default();
+    }
+
+    pub fn is_broker_local_only(&self) -> bool {
+        self.broker_local_only.load(Ordering::Acquire)
+    }
+
+    /// Registration waits until copied native credentials have been dropped by remote work.
+    pub async fn await_broker_local_only(&self) {
+        self.enter_broker_local_only();
+        let tasks = std::mem::take(
+            &mut *self
+                .broker_remote_tasks
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner),
+        );
+        for task in tasks {
+            match task.await {
+                Ok(()) => {}
+                Err(err) if err.is_cancelled() => {}
+                Err(_) => warn!("native plugin task failed during broker adoption"),
+            }
+        }
+        let _drained = self.broker_remote_admission.write().await;
+    }
