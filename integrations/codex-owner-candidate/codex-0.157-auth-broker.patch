+fn broker_status_fields(cell: &impl HistoryCell) -> String {
+    let labels = [
+        "Account",
+        "Cached route",
+        "Provider expiry",
+        "Custody expiry",
+        "Route observed",
+    ];
+    render_lines(&cell.display_lines(120))
+        .into_iter()
+        .filter_map(|line| {
+            let line = line.trim_matches(['│', ' ']);
+            let (label, value) = line.split_once(':')?;
+            labels
+                .contains(&label.trim())
+                .then(|| format!("{}: {}", label.trim(), value.trim()))
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
