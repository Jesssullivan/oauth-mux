+    async fn owner_attach_admission(&self, thread_id: ThreadId) -> std::io::Result<()> {
+        #[cfg(test)]
+        OWNER_ATTACH_ADMISSION_ENTRIES.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+        self.owner_loaded_thread(thread_id).await?;
+        let thread = self
+            .thread_manager
+            .get_thread(thread_id)
+            .await
+            .map_err(|_| std::io::Error::other("native owner requires a loaded thread"))?;
+        let status = if codex_core::auth_broker::is_startup_registration(thread_id) {
+            // Internal prepared startup has been inserted in ThreadManager but
+            // deliberately has not published readiness to the watch manager.
+            ThreadStatus::Idle
+        } else {
+            self.thread_watch_manager
+                .loaded_status_for_thread(&thread_id.to_string())
+                .await
+        };
+        admit_broker_attach(
+            status,
+            thread.agent_status().await,
+            thread.has_active_realtime_conversation().await,
+        )
+        .map_err(|_| std::io::Error::other("native thread cannot safely attach"))?;
+        self.thread_manager
+            .disable_native_analytics_delivery()
+            .await;
+        self.thread_manager.enter_broker_local_only().await;
+        self.thread_manager
+            .drain_broker_mcp_authority(thread_id)
+            .await
+            .map_err(|_| std::io::Error::other("native ancillary authority did not drain"))?;
+        Ok(())
+    }
+
+    pub(crate) async fn owner_activate(
+        &self,
+        thread_id: ThreadId,
+        socket: &str,
+        capability: &str,
+        ack: codex_core::auth_broker::NativeAckTuple,
+        peer: codex_core::native_peer::PeerWitness,
+    ) -> std::io::Result<()> {
+        if !codex_core::auth_broker::registration_paths_match(
+            thread_id,
+            std::path::Path::new(socket),
+            std::path::Path::new(capability),
+        ) {
+            return Err(std::io::Error::other("native owner configuration mismatch"));
+        }
+        // Authenticate before stopping telemetry or draining any native
+        // authority. Activation repeats the locked check after these awaits.
+        codex_core::auth_broker::check_registration(thread_id, &ack, peer)?;
+        self.owner_attach_admission(thread_id).await?;
+        codex_core::auth_broker::activate_registration(thread_id, ack, peer)?;
+        self.thread_manager.enter_broker_descriptive_mode();
+        Ok(())
+    }
+
+    pub(crate) async fn owner_announce(
+        &self,
+        thread_id: ThreadId,
+        socket: String,
+        capability: String,
+        operation: String,
+    ) -> std::io::Result<codex_core::auth_broker::NativeAckTuple> {
+        codex_core::auth_broker::check_registration_request(
+            thread_id,
+            std::path::Path::new(&socket),
+            std::path::Path::new(&capability),
+            &thread_id.to_string(),
+            &operation,
+        )?;
+        self.owner_loaded_thread(thread_id).await?;
+        // Reserve the pending fence atomically before any ancillary drain or
+        // daemon round trip. Existing work refuses; new work observes pending.
