+async fn fetch_broker_thread_status(
+    request_handle: AppServerRequestHandle,
+    thread_id: ThreadId,
+) -> Result<Option<OmuxBrokerThreadStatusResponse>, String> {
+    let result = request_handle
+        .request_typed::<OmuxBrokerThreadStatusResponse>(ClientRequest::OmuxBrokerThreadStatus {
+            request_id: RequestId::String(format!("omux-thread-status-{}", Uuid::new_v4())),
+            params: OmuxBrokerThreadStatusParams {
+                thread_id: thread_id.to_string(),
+            },
+        })
+        .await;
+    cached_broker_status_result(thread_id, result)
+}
+
+fn cached_broker_status_result(
+    thread_id: ThreadId,
+    result: std::result::Result<OmuxBrokerThreadStatusResponse, TypedRequestError>,
+) -> Result<Option<OmuxBrokerThreadStatusResponse>, String> {
+    match result {
+        Ok(response) if response.thread_id == thread_id.to_string() => Ok(Some(response)),
+        Ok(_) => Err(
+            "Account route status returned a different thread; native quota refresh was skipped."
+                .to_string(),
+        ),
+        Err(TypedRequestError::Server { source, .. }) if source.code == -32601 => Ok(None),
+        Err(_) => Err(
+            "Account route status is unavailable; native quota refresh was skipped.".to_string(),
+        ),
+    }
