+    ) -> std::io::Result<Vec<codex_app_server_protocol::OmuxOwnerThread>> {
+        let ids = self.thread_manager.list_thread_ids().await;
+        if ids.len() > 1024 {
+            return Err(std::io::Error::other(
+                "native thread inventory exceeds bound",
+            ));
+        }
+        let mut result = Vec::with_capacity(ids.len());
+        for id in ids {
+            self.owner_loaded_thread(id).await?;
+            let (thread_instance_generation, attachment_generation) =
+                codex_core::auth_broker::owner_thread_descriptor(id)?;
+            let thread_id = id.to_string();
+            if thread_id.len() > 256 {
+                return Err(std::io::Error::other(
+                    "native thread identifier exceeds bound",
+                ));
+            }
+            result.push(codex_app_server_protocol::OmuxOwnerThread {
+                thread_id,
+                thread_instance_generation,
+                attachment_generation,
+            });
+        }
+        Ok(result)
+    }
