+#[tokio::test]
+async fn broker_disable_native_delivery_fences_all_clones_and_discards_queued_facts() {
+    let client = AnalyticsEventsClient::new(
+        codex_login::AuthManager::from_auth_for_testing(
+            codex_login::CodexAuth::create_dummy_chatgpt_auth_for_testing(),
+        ),
+        "https://chatgpt.com/backend-api".to_string(),
+        Some(true),
+    );
+    let cloned = client.clone();
+    // No scheduling point precedes cancellation: this fact must be discarded
+    // rather than delivered with the previously captured native account.
+    client.track_notification(&ServerNotification::ThreadArchived(
+        ThreadArchivedNotification {
+            thread_id: "synthetic-thread".to_string(),
+        },
+    ));
+    cloned.disable_native_delivery().await;
+    assert!(!client.is_enabled());
+    assert!(!cloned.is_enabled());
+    assert!(
+        client
+            .queue
+            .as_ref()
+            .expect("shared queue")
+            .sender
+            .is_closed()
+    );
+    client.flush().await;
+    cloned.disable_native_delivery().await;
+}
+
+#[tokio::test]
+async fn broker_disable_native_delivery_waits_for_inflight_future_destruction() {
+    use std::sync::atomic::AtomicBool;
+    use std::sync::atomic::Ordering;
+
+    struct PendingDelivery(Arc<AtomicBool>);
+    impl Drop for PendingDelivery {
+        fn drop(&mut self) {
+            self.0.store(true, Ordering::Release);
+        }
+    }
+
+    let delivery = Arc::new(super::NativeAnalyticsDelivery::default());
+    let worker_delivery = Arc::clone(&delivery);
+    let dropped = Arc::new(AtomicBool::new(false));
+    let worker_dropped = Arc::clone(&dropped);
+    let (started_tx, started_rx) = tokio::sync::oneshot::channel();
+    let worker = tokio::spawn(async move {
+        worker_delivery
+            .run_until_disabled(async move {
+                let _pending = PendingDelivery(worker_dropped);
+                started_tx.send(()).expect("start waiter");
+                std::future::pending::<()>().await;
+            })
+            .await;
+    });
+    started_rx.await.expect("delivery started");
+    delivery.disable_and_wait().await;
+    assert!(dropped.load(Ordering::Acquire));
+    assert!(!delivery.is_enabled());
+    worker.await.expect("cancelled delivery worker");
+}
