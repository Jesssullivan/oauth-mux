+}
diff --git a/codex-rs/core/src/auth_broker_owner_tests.rs b/codex-rs/core/src/auth_broker_owner_tests.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/core/src/auth_broker_owner_tests.rs
@@ -0,0 +1,306 @@
+//! Core-only owner predicates using genuine owned sockets and public production
+//! registration APIs. No fabricated peer or NativeRef constructor bypasses
+//! admission. The fake daemon does not prove Omux or live provider continuity.
+use super::*;
+use crate::native_peer::{PacketListener, VerifiedPacket};
+use std::os::unix::fs::PermissionsExt;
+use tempfile::TempDir;
+use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+use tokio::net::UnixListener;
+
+struct ProcessFixture {
+    _directory: TempDir,
+    listener: Mutex<PacketListener>,
+    endpoint: PathBuf,
+}
+static PROCESS: OnceLock<std::io::Result<ProcessFixture>> = OnceLock::new();
+
+fn process() -> std::io::Result<&'static ProcessFixture> {
+    PROCESS
+        .get_or_init(|| {
+            let directory = tempfile::tempdir()?;
+            std::fs::set_permissions(directory.path(), std::fs::Permissions::from_mode(0o700))?;
+            let endpoint = directory.path().join("owner.sock");
+            let listener = PacketListener::bind(&endpoint)?;
+            std::fs::set_permissions(&endpoint, std::fs::Permissions::from_mode(0o600))?;
+            install_process_owner(ProcessOwner {
+                owner_id: crate::native_peer::random_handle()?,
+                process_nonce: crate::native_peer::random_handle()?,
+                owner_endpoint: endpoint.clone(),
+                endpoint_generation: "1".to_owned(),
+            })?;
+            Ok(ProcessFixture {
+                _directory: directory,
+                listener: Mutex::new(listener),
+                endpoint,
+            })
+        })
+        .as_ref()
+        .map_err(|_| invalid("owned native core fixture unavailable"))
+}
+
+fn native_callback(
+    tuple: NativeAckTuple,
+    detach: bool,
+) -> std::io::Result<(NativeAckTuple, PeerWitness)> {
+    let process = process()?;
+    let listener = process
+        .listener
+        .lock()
+        .map_err(|_| invalid("owned native fixture listener unavailable"))?;
+    let mut caller = VerifiedPacket::connect(&process.endpoint)?;
+    let mut native = listener.try_accept()?;
+    let encoded =
+        serde_json::to_vec(&tuple).map_err(|_| invalid("native fixture tuple encoding failed"))?;
+    caller.send_packet(&encoded)?;
+    let mut buffer = [0u8; crate::native_peer::MAX_PACKET];
+    let size = native.recv_packet(&mut buffer)?;
+    let received: NativeAckTuple = serde_json::from_slice(&buffer[..size])
+        .map_err(|_| invalid("native fixture tuple decoding failed"))?;
+    let thread_id = ThreadId::from_string(&received.thread_id)
+        .map_err(|_| invalid("native fixture thread invalid"))?;
+    let peer = native.witness();
+    let ack = if detach {
+        detach_exact(thread_id, received, peer.clone())?
+    } else {
+        check_registration(thread_id, &received, peer.clone())?;
+        activate_registration(thread_id, received, peer.clone())?
+    };
+    native.send_packet(
+        &serde_json::to_vec(&ack).map_err(|_| invalid("native fixture ACK encoding failed"))?,
+    )?;
+    let size = caller.recv_packet(&mut buffer)?;
+    let returned: NativeAckTuple = serde_json::from_slice(&buffer[..size])
+        .map_err(|_| invalid("native fixture ACK decoding failed"))?;
+    if returned != tuple {
+        return Err(invalid("native fixture ACK tuple changed"));
+    }
+    Ok((returned, peer))
+}
+
+pub(crate) struct Custody {
+    pub(crate) tuple: NativeAckTuple,
+    detach_tuple: NativeAckTuple,
+}
+
+impl Custody {
+    pub(crate) fn detach(&self) -> std::io::Result<()> {
+        native_callback(self.detach_tuple.clone(), true).map(|_| ())
+    }
+}
+impl Drop for Custody {
+    fn drop(&mut self) {
+        if self.detach().is_err() {
+            panic!("owned native core fixture detach failed");
+        }
+        if let Ok(thread_id) = ThreadId::from_string(&self.tuple.thread_id) {
+            forget(thread_id);
+        }
+    }
+}
+
+pub(crate) async fn complete(
+    thread_id: ThreadId,
+    listener: &UnixListener,
+) -> std::io::Result<(Arc<BrokerBinding>, Custody)> {
+    complete_at_epoch(thread_id, listener, "1", None).await
+}
+
+async fn complete_at_epoch(
+    thread_id: ThreadId,
+    listener: &UnixListener,
+    adapter_epoch: &str,
+    attachment_generation: Option<&str>,
+) -> std::io::Result<(Arc<BrokerBinding>, Custody)> {
+    let pending = tokio::spawn(async move { finish_registration(thread_id).await });
+    let (stream, _) = tokio::time::timeout(Duration::from_secs(5), listener.accept())
+        .await
+        .map_err(|_| invalid("native registration request was not received"))??;
+    let custody = reply_at_epoch(thread_id, stream, adapter_epoch, attachment_generation).await?;
+    let committed = tokio::time::timeout(Duration::from_secs(5), pending)
+        .await
+        .map_err(|_| invalid("native fixture registration did not complete"))?
+        .map_err(|_| invalid("native fixture registration worker stopped"))??;
+    if committed != custody.tuple {
+        return Err(invalid("native fixture committed ACK mismatches original"));
+    }
+    let binding =
+        binding(thread_id).ok_or_else(|| invalid("native fixture committed binding missing"))?;
+    Ok((binding, custody))
+}
+
+pub(crate) async fn reply_registration(
+    thread_id: ThreadId,
+    stream: tokio::net::UnixStream,
+) -> std::io::Result<Custody> {
+    reply_at_epoch(thread_id, stream, "1", None).await
+}
+
+async fn reply_at_epoch(
+    thread_id: ThreadId,
+    stream: tokio::net::UnixStream,
+    adapter_epoch: &str,
+    attachment_generation: Option<&str>,
+) -> std::io::Result<Custody> {
+    let identity = identify(thread_id)?;
+    let mut stream = BufReader::new(stream);
+    let mut frame = Vec::new();
+    stream.read_until(b'\n', &mut frame).await?;
+    if frame.len() > MAX_FRAME || frame.last() != Some(&b'\n') {
+        return Err(invalid("native fixture registration framing invalid"));
+    }
+    let request: Value = serde_json::from_slice(&frame)
+        .map_err(|_| invalid("native fixture registration request invalid"))?;
+    if request["method"] != "adapter.owner.register"
+        || request["params"]["owner_id"] != identity.owner_id
+        || request["params"]["process_nonce"] != identity.process_nonce
+        || request["params"]["operation_id"] != identity.operation_id
+        || request["params"]["thread_id"] != identity.thread_id
+        || request["params"]["thread_instance_generation"] != identity.thread_instance_generation
+    {
+        return Err(invalid("native fixture registration authority changed"));
+    }
+    let attachment_generation = match attachment_generation {
+        Some(generation) => generation.to_owned(),
+        None => owner_thread_descriptor(thread_id)?.1,
+    };
+    let tuple = NativeAckTuple {
+        protocol_version: PROTOCOL_VERSION,
+        owner_id: identity.owner_id,
+        process_nonce: identity.process_nonce,
+        adapter_epoch: adapter_epoch.to_owned(),
+        endpoint_generation: identity.endpoint_generation,
+        thread_id: identity.thread_id,
+        thread_instance_generation: identity.thread_instance_generation,
+        attachment_generation,
+        operation_id: identity.operation_id,
+    };
+    // Pending state remains unusable even after the native activation effect.
+    assert!(begin_broker_request(thread_id).is_err());
+    assert!(try_acquire_ambient_activity(thread_id).is_none());
+    let (activated, _) = native_callback(tuple.clone(), false)?;
+    assert!(begin_broker_request(thread_id).is_err());
+    assert!(require_owner_ready(thread_id).is_err());
+    let response = json!({"jsonrpc":"2.0","id":1,"result":{
+        "native_ref":activated.native_ref(),"operation_id":activated.operation_id,"registered":true,
+    }});
+    let mut encoded = serde_json::to_vec(&response)
+        .map_err(|_| invalid("native fixture committed result invalid"))?;
+    encoded.push(b'\n');
+    stream.get_mut().write_all(&encoded).await?;
+    let mut detach_tuple = tuple.clone();
+    detach_tuple.operation_id = new_operation();
+    Ok(Custody {
+        tuple,
+        detach_tuple,
+    })
+}
+
+pub(crate) fn initialize() -> std::io::Result<()> {
+    process().map(|_| ())
+}
+
+#[tokio::test]
+async fn new_actor_epoch_starts_at_one_after_real_exact_retirement() -> std::io::Result<()> {
+    initialize()?;
+    let directory = tempfile::tempdir()?;
+    std::fs::set_permissions(directory.path(), std::fs::Permissions::from_mode(0o700))?;
+    let socket = directory.path().join("broker.sock");
+    let listener = UnixListener::bind(&socket)?;
+    std::fs::set_permissions(&socket, std::fs::Permissions::from_mode(0o600))?;
+    let capability = directory.path().join("capability");
+    std::fs::write(&capability, "b".repeat(64))?;
+    std::fs::set_permissions(&capability, std::fs::Permissions::from_mode(0o600))?;
+    let thread = ThreadId::new();
+    register(
+        thread,
+        socket.clone(),
+        capability.clone(),
+        thread.to_string(),
+    )
+    .await?;
+    let (_, first) = complete(thread, &listener).await?;
+    assert!(first.tuple.adapter_epoch == "1" && first.tuple.attachment_generation == "1");
+    first.detach()?;
+    // The diagnostic listing refers to the known old epoch, not a future actor.
+    assert!(owner_thread_descriptor(thread)?.1 == "2");
+    prepare_registration(
+        thread,
+        socket,
+        capability,
+        thread.to_string(),
+        Some(new_operation()),
+    )?;
+    let (current, second) = complete_at_epoch(thread, &listener, "2", Some("1")).await?;
+    assert!(second.tuple.attachment_generation == "1");
+    assert!(second.tuple.thread_instance_generation == first.tuple.thread_instance_generation);
+    assert!(native_callback(first.tuple.clone(), false).is_err());
+    // An exact cached old retirement ACK cannot retire the new incarnation.
+    first.detach()?;
+    assert!(binding(thread).is_some_and(|binding| Arc::ptr_eq(&binding, &current)));
+    drop(first);
+    second.detach()?;
+    drop(second);
+    Ok(())
+}
+
+#[test]
+fn owner_wire_requires_lower_hex_and_canonical_full_u64_generations() {
+    let mut reference = NativeRef {
+        owner_id: "1".repeat(64),
+        adapter_epoch: u64::MAX.to_string(),
+        endpoint_generation: "1".to_owned(),
+        thread_instance_generation: "1".to_owned(),
+        attachment_generation: "1".to_owned(),
+    };
+    assert!(reference.validate().is_ok());
+    for invalid in ["0", "01", "+1", "-1", "1.0", "18446744073709551616"] {
+        reference.adapter_epoch = invalid.to_owned();
+        assert!(reference.validate().is_err());
+    }
+    reference.adapter_epoch = "1".to_owned();
+    reference.owner_id = "A".repeat(64);
+    assert!(reference.validate().is_err());
+}
+
+#[test]
+fn metadata_capacity_and_generation_unavailable_preserve_existing_identity_and_managed_refusal()
+-> std::io::Result<()> {
+    // This local metadata registry has no owner, NativeRef, witness or binding.
+    // Both ordinary preparation and managed admission use this same predicate.
+    let mut metadata = BrokerRegistry::default();
+    let first = ThreadId::new();
+    assert!(prepare_thread_identity(&mut metadata, first)? == NativeThreadPreparation::Prepared);
+    let original = metadata
+        .thread_identities
+        .get(&first)
+        .cloned()
+        .ok_or_else(|| invalid("prepared metadata missing"))?;
+    for _ in 1..MAX_NATIVE_THREADS {
+        assert!(
+            prepare_thread_identity(&mut metadata, ThreadId::new())?
+                == NativeThreadPreparation::Prepared
+        );
+    }
+    let next_generation = metadata.next_thread_generation;
+    let refused = ThreadId::new();
+    assert!(
+        prepare_thread_identity(&mut metadata, refused)? == NativeThreadPreparation::Unavailable
+    );
+    assert!(ensure_thread_identity(&mut metadata, refused).is_err());
+    assert!(!metadata.thread_identities.contains_key(&refused));
+    assert!(metadata.thread_identities.len() == MAX_NATIVE_THREADS);
+    assert!(metadata.next_thread_generation == next_generation);
+    assert!(prepare_thread_identity(&mut metadata, first)? == NativeThreadPreparation::Prepared);
+    assert!(metadata.thread_identities.get(&first) == Some(&original));
+    let mut exhausted = BrokerRegistry {
+        next_thread_generation: u64::MAX,
+        ..Default::default()
+    };
+    assert!(
+        prepare_thread_identity(&mut exhausted, refused)? == NativeThreadPreparation::Unavailable
+    );
+    assert!(ensure_thread_identity(&mut exhausted, refused).is_err());
+    assert!(exhausted.thread_identities.is_empty() && exhausted.next_thread_generation == u64::MAX);
+    Ok(())
+}
