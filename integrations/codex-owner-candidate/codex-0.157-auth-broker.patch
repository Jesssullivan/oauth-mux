+        let response = client
+            .request(ClientRequest::ThreadStart {
+                request_id: RequestId::Integer(42),
+                params: ThreadStartParams {
+                    ephemeral: Some(true),
+                    ..ThreadStartParams::default()
+                },
+            })
+            .await
+            .expect("local transport")
+            .expect("unconfigured native thread");
+        let parsed: ThreadStartResponse = serde_json::from_value(response).expect("thread schema");
+        let thread_id =
+            codex_protocol::ThreadId::from_string(&parsed.thread.id).expect("actual thread id");
+        let expected =
+            codex_core::auth_broker::identify(thread_id).expect("actual prepared native identity");
+        let home = client
+            ._test_codex_home
+            .as_ref()
+            .expect("owned fixture home")
+            .path()
+            .to_path_buf();
+        // tempfile's default directory mode follows the process umask. The
+        // real registration validator requires a private immediate parent for
+        // both the broker socket and capability, not just private leaf modes.
+        std::fs::set_permissions(&home, std::fs::Permissions::from_mode(0o700))
+            .expect("private owned fixture home");
+        let endpoint = home
