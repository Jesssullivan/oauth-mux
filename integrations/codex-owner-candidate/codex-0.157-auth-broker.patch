+        let deadline = tokio::time::Instant::now() + std::time::Duration::from_secs(3);
+        while !child_path.exists() {
+            assert!(
+                tokio::time::Instant::now() < deadline,
+                "owned child endpoint startup deadline"
+            );
+            tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+        }
+        let request = serde_json::json!({"jsonrpc":"2.0","id":operation_id,
+            "method":"owner/register","params":effect_params});
+        let envelope =
+            serde_json::to_vec(&serde_json::json!({"endpoint":endpoint,"request":request}))
+                .expect("fixture carrier");
+        let response = owner_fixture_exchange(child_path, envelope).await;
+        assert!(response.get("error").is_some());
+        assert_eq!(
+            crate::request_processors::ThreadRequestProcessor::owner_admission_effect_count(),
+            effects_before
+        );
+        assert!(
+            tokio::task::spawn_blocking(move || child.wait())
+                .await
+                .expect("owned child waiter")
+                .expect("owned child status")
+                .success()
+        );
+        // Positive control goes through the same authenticated native callback,
+        // then the producer's original protected reply decoder. It also proves
+        // the distinct announce response has the exact successful wire shape.
+        let valid = serde_json::to_vec(&serde_json::json!({"jsonrpc":"2.0","id":operation_id,
+            "method":"owner/register","params":effect_params}))
+        .expect("authorized exact callback");
+        let response = owner_fixture_exchange(endpoint, valid).await;
+        assert!(
+            response.get("error").is_none(),
+            "positive native activation was refused"
+        );
+        assert_eq!(response["result"]["registered"], true);
+        assert_eq!(
+            crate::request_processors::ThreadRequestProcessor::owner_admission_effect_count(),
+            effects_before + 1
+        );
+        let mut committed = serde_json::to_vec(&serde_json::json!({"jsonrpc":"2.0","id":1,
+            "result":{"registered":true,"native_ref":tuple.native_ref(),"operation_id":operation_id}})).expect("exact registration fixture result");
+        committed.push(b'\n');
+        broker
+            .get_mut()
+            .write_all(&committed)
+            .await
+            .expect("original producer commit response");
+        let response = completion.await.expect("bounded original producer");
+        assert!(response.get("error").is_none());
+        let announced: codex_app_server_protocol::OmuxOwnerAnnounceResponse =
+            serde_json::from_value(response["result"].clone())
+                .expect("distinct strict announce response");
+        assert!(announced.registered);
+        assert_eq!(announced.operation_id, tuple.operation_id);
+        assert_eq!(announced.owner_id, tuple.owner_id);
+        assert_eq!(announced.process_nonce, tuple.process_nonce);
+        assert_eq!(announced.adapter_epoch, tuple.adapter_epoch);
+        assert_eq!(announced.endpoint_generation, tuple.endpoint_generation);
+        assert_eq!(
+            announced.thread_instance_generation,
+            tuple.thread_instance_generation
+        );
+        assert_eq!(announced.attachment_generation, tuple.attachment_generation);
+        assert_eq!(announced.thread_id, tuple.thread_id);
+        codex_core::auth_broker::require_owner_ready(thread_id)
+            .expect("only committed producer reply releases readiness");
+        client.shutdown().await.expect("owned embedded shutdown");
+    }
+
+    #[cfg(target_os = "linux")]
+    async fn owner_fixture_exchange(
+        endpoint: std::path::PathBuf,
+        request: Vec<u8>,
+    ) -> serde_json::Value {
+        let bytes = tokio::task::spawn_blocking(move || {
+            let mut connection = codex_core::native_peer::VerifiedPacket::connect(&endpoint)?;
+            connection.send_packet(&request)?;
+            let mut bytes = vec![0; codex_core::native_peer::MAX_PACKET];
+            let size = connection.recv_packet(&mut bytes)?;
+            bytes.truncate(size);
+            Ok::<_, std::io::Error>(bytes)
+        })
+        .await
+        .expect("owned bounded packet worker")
+        .expect("actual verified fixture exchange");
+        serde_json::from_slice(&bytes).expect("actual fixture response")
+    }
+
+    #[cfg(target_os = "linux")]
+    #[test]
+    fn native_owner_callback_peer_fixture() {
+        let Some(path) = std::env::var_os("OMUX_OWNER_CALLBACK_FIXTURE_ENDPOINT") else {
+            return;
+        };
+        let listener = codex_core::native_peer::PacketListener::bind(std::path::Path::new(&path))
+            .expect("owned child listener");
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+        let mut incoming = loop {
+            match listener.try_accept() {
+                Ok(connection) => break connection,
+                Err(error)
+                    if error.kind() == std::io::ErrorKind::WouldBlock
+                        && std::time::Instant::now() < deadline =>
+                {
+                    std::thread::sleep(std::time::Duration::from_millis(10))
+                }
+                Err(_) => panic!("child fixture accept refused"),
+            }
+        };
+        let mut bytes = vec![0; codex_core::native_peer::MAX_PACKET];
+        let size = incoming
+            .recv_packet(&mut bytes)
+            .expect("verified fixture parent");
+        let envelope: serde_json::Value =
+            serde_json::from_slice(&bytes[..size]).expect("fixture envelope");
+        let endpoint = envelope["endpoint"]
+            .as_str()
+            .expect("generated private endpoint");
+        let request = serde_json::to_vec(&envelope["request"]).expect("generated callback");
+        let mut callback =
+            codex_core::native_peer::VerifiedPacket::connect(std::path::Path::new(endpoint))
+                .expect("actual child callback");
+        callback
+            .send_packet(&request)
+            .expect("child current writer");
+        let size = callback
+            .recv_packet(&mut bytes)
+            .expect("native callback refusal");
+        incoming
+            .send_packet(&bytes[..size])
+            .expect("bounded fixture reply");
+        // Keep the actual writer process alive until the parent has received
+        // and verified its reply, then observe the parent's connection close.
+        let _ = incoming.recv_packet(&mut bytes);
+    }
