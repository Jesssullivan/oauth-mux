+pub(crate) fn native_reentry_pending(thread_id: ThreadId) -> bool {
+    bindings()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .detached
+        .contains(&thread_id)
+}
