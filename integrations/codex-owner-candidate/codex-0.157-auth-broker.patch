+//! Managed constructor boundary, using the actual ThreadManager and owned
+//! credential-aware channels. The private fake daemon proves no provider work.
+use super::*;
+use crate::auth_broker;
+use codex_config::config_toml::OmuxBrokerConfig;
+use codex_protocol::protocol::{EventMsg, Op};
+use std::os::unix::fs::PermissionsExt;
+use std::time::Duration;
+use tokio::net::UnixListener;
+
+struct HeldNativeTask {
+    entered: Arc<tokio::sync::Notify>,
+    ran: Arc<std::sync::atomic::AtomicBool>,
+}
+
+impl crate::tasks::SessionTask for HeldNativeTask {
+    fn kind(&self) -> crate::state::TaskKind {
+        crate::state::TaskKind::Regular
+    }
+    fn span_name(&self) -> &'static str {
+        "session_task.native_owner_fixture"
+    }
+    async fn run(
+        self: Arc<Self>,
+        _session: Arc<crate::session::session::Session>,
+        _context: Arc<crate::session::turn_context::TurnContext>,
+        _input: Vec<crate::session::TurnInput>,
+        cancellation: tokio_util::sync::CancellationToken,
+    ) -> crate::tasks::SessionTaskResult {
+        self.ran.store(true, Ordering::SeqCst);
+        self.entered.notify_one();
+        cancellation.cancelled().await;
+        Err(codex_protocol::error::CodexErr::TurnAborted)
+    }
+}
+
+#[tokio::test]
+async fn native_owner_constructor_publishes_before_ack_and_fences_work_until_commit()
+-> anyhow::Result<()> {
+    auth_broker::owner_tests::initialize()?;
+    let directory = tempfile::tempdir()?;
+    std::fs::set_permissions(directory.path(), std::fs::Permissions::from_mode(0o700))?;
+    let socket = directory.path().join("broker.sock");
+    let listener = UnixListener::bind(&socket)?;
+    std::fs::set_permissions(&socket, std::fs::Permissions::from_mode(0o600))?;
+    let capability_path = directory.path().join("capability");
+    std::fs::write(&capability_path, "b".repeat(64))?;
+    std::fs::set_permissions(&capability_path, std::fs::Permissions::from_mode(0o600))?;
+    let home = directory.path().join("codex-home");
+    std::fs::create_dir(&home)?;
+    std::fs::set_permissions(&home, std::fs::Permissions::from_mode(0o700))?;
+    let mut config = crate::config::test_config().await;
+    config.codex_home = AbsolutePathBuf::from_absolute_path(&home)?;
+    config.cwd = AbsolutePathBuf::from_absolute_path(&home)?;
+    config.ephemeral = true;
+    let unmanaged_config = config.clone();
+    let mut layer = toml::Table::new();
+    layer.insert(
+        "omux_broker".to_owned(),
+        toml::Value::try_from(OmuxBrokerConfig {
+            broker_socket: socket.clone(),
+            capability_path: capability_path.clone(),
+        })?,
+    );
+    config.config_layer_stack = codex_config::ConfigLayerStack::new(
+        vec![codex_config::ConfigLayerEntry::new(
+            codex_config::ConfigLayerSource::SessionFlags,
+            toml::Value::Table(layer),
+        )],
+        Default::default(),
+        Default::default(),
+    )?;
+    let mut manager = ThreadManager::with_models_provider_and_home_for_tests(
+        CodexAuth::from_api_key("synthetic-unused-key"),
+        config.model_provider.clone(),
+        home,
+        Arc::new(EnvironmentManager::default_for_tests()),
+    );
+    let state = Arc::get_mut(&mut manager.state).expect("unshared private manager");
+    state.models_manager = build_models_manager(&config, Arc::clone(&state.auth_manager));
+    state.plugins_manager.enter_broker_local_only();
+    let thread_id = ThreadId::new();
+    let startup = manager.start_thread(StartThreadOptions {
+        reserved_thread_id: Some(thread_id),
+        environments: Some(Vec::new()),
+        session_source: Some(SessionSource::Cli),
+        ..StartThreadOptions::new(config)
+    });
+    tokio::pin!(startup);
+    let (stream, _) = tokio::time::timeout(Duration::from_secs(5), async {
+        tokio::select! {
+            accepted = listener.accept() => accepted,
+            _ = &mut startup => panic!("managed constructor exposed readiness without registration ACK"),
+        }
+    }).await??;
+    let published = manager.get_thread(thread_id).await?;
+    let refused_task = Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let context = published
+        .session
+        .new_turn_with_default_settings("pending-task".to_owned(), Default::default())
+        .await;
+    published
+        .session
+        .spawn_task(
+            context,
+            Vec::new(),
+            HeldNativeTask {
+                entered: Arc::new(tokio::sync::Notify::new()),
+                ran: Arc::clone(&refused_task),
+            },
+        )
+        .await;
+    assert!(!refused_task.load(Ordering::SeqCst));
+    assert!(auth_broker::is_startup_registration(thread_id));
+    assert!(auth_broker::binding(thread_id).is_none());
+    assert!(auth_broker::begin_broker_request(thread_id).is_err());
+    assert!(auth_broker::begin_native_work(thread_id).is_err());
+    assert!(auth_broker::try_acquire_ambient_activity(thread_id).is_none());
+    assert!(
+        tokio::time::timeout(Duration::from_millis(20), &mut startup)
+            .await
+            .is_err()
+    );
+    let submission = published.submit(Op::Compact).await?;
+    tokio::time::timeout(Duration::from_secs(5), async {
+        loop {
+            let event = published.next_event().await?;
+            if event.id == submission {
+                match event.msg {
+                    EventMsg::Error(_) => return Ok::<(), anyhow::Error>(()),
+                    _ => panic!("managed pending work produced an effect event"),
+                }
+            }
+        }
+    })
+    .await??;
+    let custody = auth_broker::owner_tests::reply_registration(thread_id, stream).await?;
+    let started = tokio::time::timeout(Duration::from_secs(5), &mut startup).await??;
+    assert_eq!(started.thread_id, thread_id);
+    assert!(Arc::ptr_eq(&started.thread, &published));
+    auth_broker::require_owner_ready(thread_id)?;
+    assert!(auth_broker::binding(thread_id).is_some());
+    let work = auth_broker::begin_native_work(thread_id)?;
+    assert!(custody.detach().is_err());
+    drop(work);
+    started.thread.shutdown_and_wait().await?;
+    custody.detach()?;
+    drop(custody);
+
+    // Start genuinely unmanaged native work through the real task dispatcher.
+    // Late-attachment preparation must lose atomically while that task lives.
+    let unmanaged = manager
+        .start_thread(StartThreadOptions {
+            environments: Some(Vec::new()),
+            session_source: Some(SessionSource::Cli),
+            ..StartThreadOptions::new(unmanaged_config)
+        })
+        .await?;
+    assert!(auth_broker::binding(unmanaged.thread_id).is_none());
+    let entered = Arc::new(tokio::sync::Notify::new());
+    let ran = Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let context = unmanaged
+        .thread
+        .session
+        .new_turn_with_default_settings("unmanaged-task".to_owned(), Default::default())
+        .await;
+    unmanaged
+        .thread
+        .session
+        .spawn_task(
+            context,
+            Vec::new(),
+            HeldNativeTask {
+                entered: Arc::clone(&entered),
+                ran: Arc::clone(&ran),
+            },
+        )
+        .await;
+    tokio::time::timeout(Duration::from_secs(5), entered.notified()).await?;
+    assert!(ran.load(Ordering::SeqCst));
+    let operation = crate::native_peer::random_handle()?;
+    let admission = auth_broker::prepare_registration(
+        unmanaged.thread_id,
+        socket.clone(),
+        capability_path.clone(),
+        unmanaged.thread_id.to_string(),
+        Some(operation.clone()),
+    );
+    assert!(
+        admission
+            .as_ref()
+            .is_err_and(|error| error.kind() == std::io::ErrorKind::WouldBlock)
+    );
+    assert!(!auth_broker::is_startup_registration(unmanaged.thread_id));
+    assert!(auth_broker::binding(unmanaged.thread_id).is_none());
+    unmanaged
+        .thread
+        .session
+        .abort_all_tasks(codex_protocol::protocol::TurnAbortReason::Interrupted)
+        .await;
+    tokio::time::timeout(Duration::from_secs(5), async {
+        loop {
+            match auth_broker::prepare_registration(
+                unmanaged.thread_id,
+                socket.clone(),
+                capability_path.clone(),
+                unmanaged.thread_id.to_string(),
+                Some(operation.clone()),
+            ) {
+                Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                    tokio::task::yield_now().await
+                }
+                result => return result,
+            }
+        }
+    })
+    .await??;
+    let (_, late_custody) =
+        auth_broker::owner_tests::complete(unmanaged.thread_id, &listener).await?;
+    unmanaged.thread.shutdown_and_wait().await?;
+    late_custody.detach()?;
+    drop(late_custody);
+    Ok(())
+}
