+#[tokio::test]
+async fn broker_status_reports_unknown_stale_and_future_cached_routes() {
+    let home = TempDir::new().expect("temp home");
+    let config = test_config(&home).await;
+    let captured_at = Utc
+        .with_ymd_and_hms(2024, 1, 2, 3, 4, 5)
+        .single()
+        .expect("timestamp")
+        .with_timezone(&Local);
+    let stale_route = serde_json::json!({
+        "provider": "codex",
+        "custody_expires_at": captured_at.timestamp() - 60,
+        "observed_at": captured_at.timestamp() - 1200
+    });
+    let future_route = serde_json::json!({
+        "provider": "codex",
+        "observed_at": captured_at.timestamp() + 60
+    });
+    let mut fields = Vec::new();
+    for route in [
+        None,
+        BrokerAccountMetadata::from_cached_route(&stale_route),
+        BrokerAccountMetadata::from_cached_route(&future_route),
+    ] {
+        let display = StatusAccountDisplay::BrokerManaged {
+            endpoint_configured: false,
+            route,
+        };
+        let cell = new_status_output(
+            &config,
+            Some(&display),
+            /*token_info*/ None,
+            &TokenUsage::default(),
+            &None,
+            /*thread_name*/ None,
+            /*forked_from*/ None,
+            /*rate_limits*/ None,
+            None,
+            captured_at,
+            &get_model_offline_for_tests(config.model.as_deref()),
+            /*collaboration_mode*/ None,
+            /*reasoning_effort_override*/ None,
+        );
+        fields.push(broker_status_fields(&cell));
+    }
+    assert_snapshot!(fields.join("\n\n"), @r"
+    Account: Omux (local endpoint unavailable)
+    Cached route: unknown (no cached metadata)
+    Provider expiry: unknown
+    Custody expiry: unknown
+    Route observed: unknown (cached observation unavailable)
+
+    Account: Omux (local endpoint unavailable)
+    Cached route: unknown (codex)
+    Provider expiry: unknown
+    Custody expiry: 2024-01-02 03:03:05 UTC (expired)
+    Route observed: 2024-01-02 02:44:05 UTC (stale cache; 20m old)
+
+    Account: Omux (local endpoint unavailable)
+    Cached route: unknown (codex)
+    Provider expiry: unknown
+    Custody expiry: unknown
+    Route observed: 2024-01-02 03:05:05 UTC (cached; clock mismatch)
+    ");
+}
