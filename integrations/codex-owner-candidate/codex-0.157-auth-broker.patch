 use codex_protocol::protocol::TurnAbortReason;
 use pretty_assertions::assert_eq;
 use serde_json::json;
+
+#[test]
+fn broker_requests_round_trip_exact_local_attachment_wire_names() -> Result<()> {
+    let cases = [
+        (
+            ClientRequest::OmuxBrokerCapabilities {
+                request_id: RequestId::Integer(1),
+                params: v2::OmuxBrokerCapabilitiesParams {},
+            },
+            json!({"id":1,"method":"omux/broker/capabilities","params":{}}),
+        ),
+        (
+            ClientRequest::OmuxBrokerRegister {
+                request_id: RequestId::Integer(2),
+                params: v2::OmuxBrokerRegisterParams {
+                    thread_id: "thread-fixture".into(),
+                    binding_id: "binding-fixture".into(),
+                    broker_socket: "/local/omux/adapter.sock".into(),
+                    capability_path: "/local/omux/adapter.capability".into(),
+                    protocol_version: 1,
+                },
+            },
+            json!({"id":2,"method":"omux/broker/register","params":{
+                "threadId":"thread-fixture","bindingId":"binding-fixture",
+                "brokerSocket":"/local/omux/adapter.sock",
+                "capabilityPath":"/local/omux/adapter.capability","protocolVersion":1,
+            }}),
+        ),
+        (
+            ClientRequest::OmuxBrokerUnregister {
+                request_id: RequestId::Integer(3),
+                params: v2::OmuxBrokerUnregisterParams {
+                    thread_id: "thread-fixture".into(),
+                    release_binding: None,
+                },
+            },
+            json!({"id":3,"method":"omux/broker/unregister","params":{"threadId":"thread-fixture","releaseBinding":null}}),
+        ),
+        (
+            ClientRequest::OmuxBrokerUnregister {
+                request_id: RequestId::Integer(4),
+                params: v2::OmuxBrokerUnregisterParams {
+                    thread_id: "thread-fixture".into(),
+                    release_binding: Some(false),
+                },
+            },
+            json!({"id":4,"method":"omux/broker/unregister","params":{"threadId":"thread-fixture","releaseBinding":false}}),
+        ),
+        (
+            ClientRequest::OmuxBrokerThreadStatus {
+                request_id: RequestId::Integer(5),
+                params: v2::OmuxBrokerThreadStatusParams {
+                    thread_id: "thread-fixture".into(),
+                },
+            },
+            json!({"id":5,"method":"omux/broker/thread/status","params":{"threadId":"thread-fixture"}}),
+        ),
+    ];
+    for (request, wire) in cases {
+        assert_eq!(serde_json::to_value(&request)?, wire);
+        assert_eq!(
+            serde_json::from_value::<ClientRequest>(wire.clone())?,
+            request
+        );
+        let mut unexpected_field = wire;
+        unexpected_field["params"]["unexpected"] = json!(true);
+        assert!(serde_json::from_value::<ClientRequest>(unexpected_field).is_err());
+    }
+    Ok(())
+}
+
+#[test]
+fn native_detach_defaults_to_release_while_coordinated_detach_can_skip_it() -> Result<()> {
+    let default: v2::OmuxBrokerUnregisterParams =
+        serde_json::from_value(json!({"threadId":"thread-fixture"}))?;
+    assert_eq!(default.release_binding.unwrap_or(true), true);
+    let coordinated: v2::OmuxBrokerUnregisterParams = serde_json::from_value(json!({
+        "threadId":"thread-fixture","releaseBinding":false,
+    }))?;
+    assert_eq!(coordinated.release_binding.unwrap_or(true), false);
+    Ok(())
+}
+
+#[test]
+fn broker_thread_status_serializes_explicitly_nullable_cached_metadata() -> Result<()> {
+    for last_observed_route in [None, Some(json!({"observed_at":123,"route_generation":7}))] {
+        let response = v2::OmuxBrokerThreadStatusResponse {
+            thread_id: "thread-fixture".into(),
+            bound: last_observed_route.is_some(),
+            last_observed_route: last_observed_route.clone(),
+        };
+        let wire = json!({
+            "threadId":"thread-fixture","bound":last_observed_route.is_some(),
+            "lastObservedRoute":last_observed_route,
+        });
+        assert_eq!(serde_json::to_value(&response)?, wire);
+        assert_eq!(
+            serde_json::from_value::<v2::OmuxBrokerThreadStatusResponse>(wire)?,
+            response
+        );
+    }
+    Ok(())
+}
+
+#[test]
+fn broker_capabilities_and_registration_responses_preserve_wire_contract() -> Result<()> {
+    let capabilities = v2::OmuxBrokerCapabilities {
+        protocol_version: 1,
+        late_thread_binding: true,
+        per_request_auth: true,
+        exclusive_refresh_owner: true,
+        preacceptance_failure: true,
+        account_transport_invalidation: true,
+        native_context_reconstruction: false,
+    };
+    let capabilities_wire = json!({
+        "protocol_version":1,"late_thread_binding":true,"per_request_auth":true,
+        "exclusive_refresh_owner":true,"preacceptance_failure":true,
+        "account_transport_invalidation":true,"native_context_reconstruction":false,
+    });
+    let response = v2::OmuxBrokerCapabilitiesResponse {
+        protocol_version: 1,
+        capabilities: capabilities.clone(),
+    };
+    let response_wire = json!({"protocolVersion":1,"capabilities":capabilities_wire});
+    assert_eq!(serde_json::to_value(&response)?, response_wire);
+    assert_eq!(
+        serde_json::from_value::<v2::OmuxBrokerCapabilitiesResponse>(response_wire)?,
+        response
+    );
+    let registered = v2::OmuxBrokerRegisterResponse {
+        binding_id: "binding-fixture".into(),
+        protocol_version: 1,
+        refresh_ownership_acknowledged: true,
+        capabilities,
+    };
+    let registered_wire = json!({
+        "bindingId":"binding-fixture","protocolVersion":1,
+        "refreshOwnershipAcknowledged":true,"capabilities":capabilities_wire,
+    });
+    assert_eq!(serde_json::to_value(&registered)?, registered_wire);
+    assert_eq!(
+        serde_json::from_value::<v2::OmuxBrokerRegisterResponse>(registered_wire)?,
+        registered
+    );
+    assert_eq!(
+        serde_json::to_value(v2::OmuxBrokerUnregisterResponse { unregistered: true })?,
+        json!({"unregistered":true})
+    );
+    Ok(())
+}
