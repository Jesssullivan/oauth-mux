+#  undef F_GET_RW_HINT
+#  pragma push_macro("F_SET_RW_HINT")
+#  undef F_SET_RW_HINT
+#  pragma push_macro("F_GET_FILE_RW_HINT")
+#  undef F_GET_FILE_RW_HINT
