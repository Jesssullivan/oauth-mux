+#define _GNU_SOURCE
+#include "native_peer.h"
+#include <string.h>
+
+#if defined(__linux__) && defined(__LP64__)
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/statfs.h>
