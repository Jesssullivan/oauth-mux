+    assert_eq!(app.chat_widget.current_plan_type(), None);
+    assert!(!app.chat_widget.has_chatgpt_account());
+    assert!(!app.chat_widget.has_codex_backend_auth());
+    assert_eq!(app.rate_limit_hard_stop_generation, generation);
+
+    app.handle_event(
+        &mut tui,
+        &mut app_server,
+        AppEvent::BrokerThreadStatusLoaded {
+            thread_id,
+            request_generation: 2,
+            origin: crate::app_event::BrokerStatusRefreshOrigin::Observe,
+            result: Ok(Some(
+                codex_app_server_protocol::OmuxBrokerThreadStatusResponse {
+                    thread_id: thread_id.to_string(),
+                    bound: false,
+                    last_observed_route: None,
