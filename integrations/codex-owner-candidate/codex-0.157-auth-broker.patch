+#[test]
+fn broker_cached_route_parser_rejects_unsafe_text_and_timestamps() {
+    for text in [
+        "contains@separator".to_owned(),
+        "\nLab".to_owned(),
+        "Lab\tproject".to_owned(),
+        "\u{1b}[31mLab".to_owned(),
+        "\u{202e}Lab".to_owned(),
+        "opaque.identifier.parts".to_owned(),
+        "00000000-0000-4000-8000-000000000001".to_owned(),
+        "x".repeat(81),
+        "   ".to_owned(),
+    ] {
+        let value = serde_json::json!({
+            "account_label": text,
+            "account_type": text,
+            "provider": text,
+            "observed_at": 1704164525
+        });
+        let parsed = BrokerAccountMetadata::from_cached_route(&value).expect("safe timestamp");
+        assert_eq!(parsed.account_label, None);
+        assert_eq!(parsed.account_type, None);
+        assert_eq!(parsed.provider, None);
+        assert_eq!(parsed.observed_at, Some(1704164525));
+    }
+    for timestamp in [
+        serde_json::json!(-1),
+        serde_json::json!(253_402_300_800_i64),
+        serde_json::json!(u64::MAX),
+        serde_json::json!(1.5),
+        serde_json::json!("unparsed"),
+    ] {
+        let value = serde_json::json!({
+            "provider_expires_at": timestamp,
+            "custody_expires_at": timestamp,
+            "observed_at": timestamp
+        });
+        assert_eq!(BrokerAccountMetadata::from_cached_route(&value), None);
+    }
+}
