+        Some(BrokerAccountMetadata {
+            account_label: Some("Lab project".to_owned()),
+            account_type: Some("oauth".to_owned()),
+            provider: Some("codex".to_owned()),
+            provider_expires_at: Some(1704164765),
+            custody_expires_at: Some(1704164705),
+            observed_at: Some(1704164525),
+        })
+    );
+    assert_eq!(
+        BrokerAccountMetadata::from_cached_route(&serde_json::json!({
+            "account_label": "Lab project"
+        })),
