 #[tokio::test]
+async fn broker_status_completion_is_scoped_to_both_active_and_displayed_thread() -> Result<()> {
+    let mut app = make_test_app().await;
+    let selected = ThreadId::new();
+    let previous = ThreadId::new();
+    app.active_thread_id = Some(selected);
+    app.chat_widget
+        .handle_thread_session(test_thread_session(selected, app.config.cwd.to_path_buf()));
+    let mut app_server = start_config_write_test_app_server(&app).await?;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let bound = |thread_id: ThreadId| codex_app_server_protocol::OmuxBrokerThreadStatusResponse {
+        thread_id: thread_id.to_string(),
+        bound: true,
+        last_observed_route: None,
+    };
+
+    app.handle_event(
+        &mut tui,
+        &mut app_server,
+        AppEvent::BrokerThreadStatusLoaded {
+            thread_id: previous,
+            request_generation: 1,
+            origin: crate::app_event::BrokerStatusRefreshOrigin::Observe,
+            result: Ok(Some(bound(previous))),
+        },
+    )
+    .await?;
+    assert!(!app.chat_widget.broker_account_managed());
+
+    app.handle_event(
+        &mut tui,
+        &mut app_server,
+        AppEvent::BrokerThreadStatusLoaded {
+            thread_id: selected,
+            request_generation: 2,
+            origin: crate::app_event::BrokerStatusRefreshOrigin::Observe,
+            result: Ok(Some(bound(previous))),
+        },
+    )
+    .await?;
+    assert!(!app.chat_widget.broker_account_managed());
+
+    app.active_thread_id = Some(previous);
+    app.handle_event(
+        &mut tui,
+        &mut app_server,
+        AppEvent::BrokerThreadStatusLoaded {
+            thread_id: selected,
+            request_generation: 3,
+            origin: crate::app_event::BrokerStatusRefreshOrigin::Observe,
+            result: Ok(Some(bound(selected))),
+        },
+    )
+    .await?;
+    assert!(!app.chat_widget.broker_account_managed());
+
+    app.active_thread_id = Some(selected);
+    app.handle_event(
+        &mut tui,
+        &mut app_server,
+        AppEvent::BrokerThreadStatusLoaded {
+            thread_id: selected,
+            request_generation: 4,
+            origin: crate::app_event::BrokerStatusRefreshOrigin::Observe,
+            result: Ok(Some(bound(selected))),
+        },
+    )
+    .await?;
+    assert!(app.chat_widget.broker_account_managed());
+    Ok(())
+}
