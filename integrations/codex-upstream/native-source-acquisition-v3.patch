new file mode 100644
--- /dev/null
+++ b/codex-rs/app-server/src/owner_source_acquisition.rs
@@ -0,0 +1,328 @@
+//! Consent-authenticated access-only descriptor transfer. No refresh ownership.
+use crate::owner_source_context::{SourceContext, SourceSnapshot, SourceSnapshotKey};
+use codex_core::auth_broker::ProcessOwner;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use std::{fs::File, io, path::Path, time::Instant};
+
+pub const PAYLOAD_FORMAT: &str = "omux-codex-access-v1";
+pub const MAX_PAYLOAD: usize = 16 * 1024;
+fn invalid() -> io::Error { io::Error::other("native source acquisition refused") }
+fn require(value: bool) -> io::Result<()> { if value { Ok(()) } else { Err(invalid()) } }
+fn opaque(value: &str) -> io::Result<()> {
+    require(value.len() == 64 && value.bytes().all(|v| v.is_ascii_digit() || (b'a'..=b'f').contains(&v))
+        && value.bytes().any(|v| v != b'0'))
+}
+fn generation(value: &str, zero: bool) -> io::Result<u64> {
+    require(!value.is_empty() && value.len() <= 20 && value.bytes().all(|v| v.is_ascii_digit())
+        && (value == "0" || !value.starts_with('0')))?;
+    let value: u64 = value.parse().map_err(|_| invalid())?;
+    require(zero || value != 0)?;
+    Ok(value)
+}
+#[derive(Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct AcquireRequest {
+    pub protocol_version: u32,
+    pub owner_id: String, pub process_nonce: String, pub endpoint_generation: String,
+    pub source_origin_id: String, pub source_context_id: String, pub source_context_generation: String,
+    pub operation_id: String, pub consent_id: String, pub consent_generation: String,
+    pub consent_expires_at: String,
+    pub source_id: String, pub source_generation: String, pub forget_epoch: String,
+    pub custody_seconds: String,
+    #[serde(skip_serializing)]
+    pub proof: String,
+}
+impl AcquireRequest {
+    pub fn validate(&self, owner: &ProcessOwner, snapshot: &SourceSnapshot) -> io::Result<()> {
+        require(self.protocol_version == 2 && self.owner_id == owner.owner_id
+            && self.process_nonce == owner.process_nonce && self.endpoint_generation == owner.endpoint_generation
+            && self.source_context_id == snapshot.context_id && self.source_context_generation == snapshot.generation
+            && snapshot.store_present)?;
+        for value in [&self.owner_id, &self.process_nonce, &self.source_origin_id, &self.source_context_id,
+            &self.operation_id, &self.consent_id, &self.source_id] { opaque(value)?; }
+        for value in [&self.endpoint_generation, &self.source_context_generation, &self.consent_generation,
+            &self.source_generation] { generation(value, false)?; }
+        require(generation(&self.consent_expires_at, false)? <= i64::MAX as u64)?;
+        generation(&self.forget_epoch, true)?;
+        let custody = generation(&self.custody_seconds, false)?;
+        require(custody <= 3600 && self.proof.len() == 64
+            && self.proof.bytes().all(|v| v.is_ascii_digit() || (b'a'..=b'f').contains(&v)))
+    }
+    pub(crate) fn canonical(&self, domain: &str) -> Vec<u8> {
+        let mut value = Vec::new();
+        for field in [domain, "2", &self.owner_id, &self.process_nonce, &self.endpoint_generation,
+            &self.source_origin_id, &self.source_context_id, &self.source_context_generation,
+            &self.operation_id, &self.consent_id, &self.consent_generation, &self.consent_expires_at, &self.source_id,
+            &self.source_generation, &self.forget_epoch, &self.custody_seconds] {
+            value.extend_from_slice(field.as_bytes()); value.push(b'\n');
+        }
+        value
+    }
+}
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct OriginRequest {
+    pub protocol_version: u32,
+    pub owner_id: String, pub process_nonce: String, pub endpoint_generation: String,
+    pub source_context_id: String, pub source_context_generation: String,
+}
+impl OriginRequest {
+    pub fn validate_owner(&self, owner: &ProcessOwner) -> io::Result<()> {
+        require(self.protocol_version == 2 && self.owner_id == owner.owner_id
+            && self.process_nonce == owner.process_nonce && self.endpoint_generation == owner.endpoint_generation)?;
+        opaque(&self.source_context_id)?; generation(&self.source_context_generation,false)?; Ok(())
+    }
+    pub fn validate(&self, owner: &ProcessOwner, snapshot: &SourceSnapshot) -> io::Result<()> {
+        require(self.protocol_version == 2 && self.owner_id == owner.owner_id
+            && self.process_nonce == owner.process_nonce && self.endpoint_generation == owner.endpoint_generation
+            && self.source_context_id == snapshot.context_id && self.source_context_generation == snapshot.generation)
+    }
+}
+pub struct Acquired { pub value: Value, pub descriptor: File, pub snapshot_key: SourceSnapshotKey, pub consent_expires_at: u64 }
+
+#[cfg(all(target_os = "linux", target_arch = "x86_64"))]
