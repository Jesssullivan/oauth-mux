+// Keep missing/ephemeral writers distinct from the legacy warn-only helper.
+async fn persist_owned_session(session: &crate::session::Session) -> std::io::Result<()> {
+    let snapshot = session.thread_config_snapshot().await;
+    if snapshot.ephemeral || matches!(snapshot.session_source, SessionSource::Internal(_)) {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::Unsupported,
+            "native owner requires non-ephemeral ordinary history",
+        ));
+    }
+    let live_thread = session.live_thread_for_persistence("persist native owned history")
+        .map_err(|_| std::io::Error::new(std::io::ErrorKind::NotFound, "native history writer unavailable"))?;
+    let original_path = live_thread.local_rollout_path().await.map_err(std::io::Error::other)?
+        .ok_or_else(|| std::io::Error::new(std::io::ErrorKind::Unsupported, "native local history writer required"))?;
+    live_thread.persist(PersistContext::Standard).await.map_err(std::io::Error::other)?;
+    let current_path = live_thread.local_rollout_path().await.map_err(std::io::Error::other)?;
+    if current_path.as_ref() != Some(&original_path) {
+        return Err(std::io::Error::new(std::io::ErrorKind::PermissionDenied, "native history writer path changed"));
+    }
+    Ok(())
+}
