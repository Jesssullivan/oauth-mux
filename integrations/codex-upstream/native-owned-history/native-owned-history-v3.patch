+/// One dispatch-scoped owner of descriptors duplicated from an authenticated
+/// packet. It never reads packets or creates a new attempt deadline.
+pub struct PeerLease {
+    #[cfg(unix)]
+    context: ContextOwner,
+    #[cfg(unix)]
+    deadline: Instant,
+    #[cfg(not(unix))]
+    unavailable: (),
+}
+
+#[cfg(unix)]
+struct ContextOwner(Context);
+#[cfg(unix)]
+impl ContextOwner {
+    fn empty() -> Self {
+        Self(Context {
+            socket_fd: -1,
+            pidfd: -1,
+            owns_socket: 0,
+            witness: Witness::default(),
+        })
+    }
+}
+#[cfg(unix)]
+impl Drop for ContextOwner {
+    fn drop(&mut self) {
+        // Safety: this single owner closes whichever descriptors were enrolled,
+        // including partial capture/duplicate failures. C clears the context.
+        unsafe { omux_peer_close(&mut self.0) };
+    }
+}
+impl PeerLease {
+    pub fn witness(&self) -> PeerWitness {
+        #[cfg(unix)]
+        {
+            PeerWitness(self.context.0.witness)
+        }
+        #[cfg(not(unix))]
+        {
+            unreachable!("unsupported platforms cannot construct peer leases")
+        }
+    }
+
+    /// Re-capture kernel identity from the held socket, rather than treating a
+    /// copied witness as current authority after an async native writer barrier.
+    pub fn check(&self) -> io::Result<()> {
+        #[cfg(unix)]
+        {
+            self.tick()?;
+            // Safety: context is owned for this entire synchronous check.
+            status(unsafe { omux_peer_alive(&self.context.0) })?;
+            let mut current = ContextOwner::empty();
+            // Safety: output already has an RAII owner; socket is still held.
+            status(unsafe {
+                omux_peer_capture(self.context.0.socket_fd, libc::getuid(), &mut current.0)
+            })?;
+            if current.0.witness != self.context.0.witness {
+                return Err(io::Error::new(
+                    io::ErrorKind::PermissionDenied,
+                    "native owner peer authority changed",
+                ));
+            }
+            let mut poll = libc::pollfd {
+                fd: self.context.0.socket_fd,
+                events: libc::POLLHUP | libc::POLLERR,
+                revents: 0,
+            };
+            // Safety: this observes connection closure without reading a frame.
+            if unsafe { libc::poll(&mut poll, 1, 0) } < 0 {
+                return Err(io::Error::last_os_error());
+            }
+            if poll.revents & (libc::POLLHUP | libc::POLLERR | libc::POLLNVAL) != 0 {
+                return Err(io::Error::new(
+                    io::ErrorKind::ConnectionAborted,
+                    "native owner peer departed",
+                ));
+            }
+            drop(current);
+            status(unsafe { omux_peer_alive(&self.context.0) })?;
+            self.tick()
+        }
+        #[cfg(not(unix))]
+        {
+            Err(io::Error::new(io::ErrorKind::Unsupported, "native peer profile unavailable"))
+        }
+    }
+
+    #[cfg(unix)]
+    fn tick(&self) -> io::Result<()> {
+        if Instant::now() >= self.deadline {
+            return Err(io::Error::new(io::ErrorKind::TimedOut, "native exchange timed out"));
+        }
+        Ok(())
+    }
+}
