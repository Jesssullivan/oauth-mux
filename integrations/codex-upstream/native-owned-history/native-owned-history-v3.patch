+            let _current = membership.thread();
+            committed.set(true);
+            Ok::<_, std::io::Error>(())
+        };
+        let replace = async {
+            // Only test-owned map access substitutes another real native Arc
+            // under the same key; no registration or ready authority is forged.
+            manager.state.threads.write().await.insert(original.thread_id, replacement.thread.clone());
+            replaced.send(()).expect("wake final activity await");
+        };
+        let (result, ()) = tokio::join!(final_activity_then_commit, replace);
+        assert_eq!(result.unwrap_err().kind(), std::io::ErrorKind::PermissionDenied);
+        assert!(!committed.get());
+        assert!(manager.captured_ops().is_empty());
+        original.thread.shutdown_and_wait().await.expect("close original runtime");
+        replacement.thread.shutdown_and_wait().await.expect("close replacement runtime");
+    }
+
+    #[tokio::test]
+    async fn loaded_membership_excludes_queued_removal_through_final_await_and_commit() {
+        let (_directory, manager, thread, _) = loaded_manager().await;
+        let membership = manager.hold_loaded_thread(thread.thread_id, &thread.thread)
+            .await.expect("hold actual current membership");
+        let mut removal = Box::pin(manager.remove_thread_for_client(&thread.thread_id));
+        std::future::poll_fn(|context| {
+            assert!(matches!(removal.as_mut().poll(context), std::task::Poll::Pending));
+            std::task::Poll::Ready(())
+        }).await;
+        // This actual final snapshot can await while the remover is queued.
+        // It must not recursively reacquire the manager's fair map read lock.
+        let snapshot = membership.thread().config_snapshot().await;
+        assert!(!snapshot.ephemeral);
+        assert!(Arc::ptr_eq(membership.thread(), &thread.thread));
+        assert!(manager.state.threads.try_write().is_err());
+        let commit_observed = Cell::new(false);
+        let commit = || { commit_observed.set(true); };
+        commit();
+        assert!(commit_observed.get());
+        drop(membership);
+        let removed = removal.await.expect("removal after commit").expect("original map member");
+        assert!(Arc::ptr_eq(&removed, &thread.thread));
+        assert!(manager.captured_ops().is_empty());
+        thread.thread.shutdown_and_wait().await.expect("close native runtime");
+    }
+
+    #[tokio::test]
+    async fn loaded_membership_cancellation_releases_actual_map_guard() {
+        let (_directory, manager, thread, _) = loaded_manager().await;
+        let membership = manager.hold_loaded_thread(thread.thread_id, &thread.thread)
+            .await.expect("actual map guard");
+        let mut final_activity = Box::pin(async move {
+            let held = membership;
+            std::future::pending::<()>().await;
+            drop(held);
+        });
+        std::future::poll_fn(|context| {
+            assert!(matches!(final_activity.as_mut().poll(context), std::task::Poll::Pending));
+            std::task::Poll::Ready(())
+        }).await;
+        assert!(manager.state.threads.try_write().is_err());
+        drop(final_activity);
+        let removed = manager.remove_thread_for_client(&thread.thread_id).await
+            .expect("remove after cancellation").expect("original runtime");
+        assert!(Arc::ptr_eq(&removed, &thread.thread));
+        assert!(manager.captured_ops().is_empty());
+        thread.thread.shutdown_and_wait().await.expect("close native runtime");
+    }
+
+    #[tokio::test]
+    async fn stopped_but_still_mapped_native_runtime_cannot_commit_owner_activation() {
+        let (_directory, manager, thread, _) = loaded_manager().await;
+        thread.thread.persist_owned_rollout().await.expect("actual native writer barrier");
+        let membership = manager.hold_loaded_thread(thread.thread_id, &thread.thread)
+            .await.expect("hold actual map membership");
+        // The actual submission loop accepts Shutdown while still mapped. Its
+        // real runtime and native writer terminate without needing the map W.
+        thread.thread.shutdown_and_wait().await.expect("actual native shutdown");
+        assert!(Arc::ptr_eq(membership.thread(), &thread.thread));
+        let commits = Cell::new(0);
+        let result = membership.thread().with_live_native_owner(|| {
+            commits.set(commits.get() + 1);
+            Ok(())
+        });
+        assert_eq!(result.unwrap_err().kind(), std::io::ErrorKind::ConnectionAborted);
+        assert_eq!(commits.get(), 0);
+        drop(membership);
+        assert!(manager.remove_thread_for_client(&thread.thread_id).await
+            .expect("remove stopped native map entry").is_some());
+    }
+}
