+#[cfg(test)]
+mod native_runtime_lifecycle_tests {
+    use super::*;
+    use std::cell::Cell;
+    use std::future::Future;
+
+    #[tokio::test]
+    async fn actual_session_lifecycle_stop_serializes_after_synchronous_commit() {
+        let (session, _) = crate::session::tests::make_session_and_context().await;
+        let session = Arc::new(session);
+        let (attempted, attempt) = std::sync::mpsc::channel();
+        let (completed, completion) = std::sync::mpsc::channel();
+        let commits = Cell::new(0);
+        let mut stopper = None;
+        session.owner_runtime.with_live(|| {
+            let other = Arc::clone(&session);
+            stopper = Some(std::thread::spawn(move || {
+                assert!(matches!(other.owner_runtime.state.try_lock(), Err(std::sync::TryLockError::WouldBlock)));
+                attempted.send(()).expect("actual lifecycle mutex is held");
+                other.owner_runtime.stop();
+                completed.send(()).expect("stop completed");
+            }));
+            attempt.recv_timeout(std::time::Duration::from_secs(10)).expect("bounded stop attempt");
+            assert!(matches!(completion.try_recv(), Err(std::sync::mpsc::TryRecvError::Empty)));
+            commits.set(commits.get() + 1);
+            Ok(())
+        }).expect("synchronous commit before stop");
+        completion.recv_timeout(std::time::Duration::from_secs(10)).expect("stop after guard release");
+        stopper.expect("owned stop thread").join().expect("join stop");
+        assert_eq!(commits.get(), 1);
+        let after = session.owner_runtime.with_live(|| { commits.set(commits.get() + 1); Ok(()) });
+        assert_eq!(after.unwrap_err().kind(), std::io::ErrorKind::ConnectionAborted);
+        assert_eq!(commits.get(), 1);
+    }
+
+    #[tokio::test]
+    async fn submission_exit_guard_cancellation_retires_actual_session_lifecycle() {
+        let (session, _) = crate::session::tests::make_session_and_context().await;
+        let mut loop_scope = Box::pin(async {
+            let _exit = session.owner_runtime.exit_guard();
+            std::future::pending::<()>().await;
+        });
+        std::future::poll_fn(|context| {
+            assert!(matches!(loop_scope.as_mut().poll(context), std::task::Poll::Pending));
+            std::task::Poll::Ready(())
+        }).await;
+        drop(loop_scope);
+        let commits = Cell::new(0);
+        let result = session.owner_runtime.with_live(|| { commits.set(commits.get() + 1); Ok(()) });
+        assert_eq!(result.unwrap_err().kind(), std::io::ErrorKind::ConnectionAborted);
+        assert_eq!(commits.get(), 0);
+        session.owner_runtime.stop();
+        assert!(session.owner_runtime.with_live(|| Ok(())).is_err());
+    }
+
+    #[tokio::test]
+    async fn lifecycle_panic_and_poison_remain_closed_without_masking_original_panic() {
+        let (session, _) = crate::session::tests::make_session_and_context().await;
+        let panic = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _exit = session.owner_runtime.exit_guard();
+            let _ = session.owner_runtime.with_live(|| -> std::io::Result<()> {
+                std::panic::panic_any(1234_u32);
+            });
+        })).expect_err("original synchronous panic");
+        assert_eq!(panic.downcast_ref::<u32>(), Some(&1234));
+        let commits = Cell::new(0);
+        assert!(session.owner_runtime.with_live(|| { commits.set(commits.get() + 1); Ok(()) }).is_err());
+        assert_eq!(commits.get(), 0);
+        // Teardown on poison still sets Stopped; it never restores Live.
+        session.owner_runtime.stop();
+        assert!(session.owner_runtime.with_live(|| Ok(())).is_err());
+    }
+
+    #[tokio::test]
+    async fn synchronous_owner_failure_releases_lifecycle_without_replay_or_false_stop() {
+        let (session, _) = crate::session::tests::make_session_and_context().await;
+        let attempts = Cell::new(0);
+        let result = session.owner_runtime.with_live(|| {
+            attempts.set(attempts.get() + 1);
+            Err(std::io::Error::from(std::io::ErrorKind::PermissionDenied))
+        });
+        assert_eq!(result.unwrap_err().kind(), std::io::ErrorKind::PermissionDenied);
+        assert_eq!(attempts.get(), 1);
+        assert!(session.owner_runtime.state.try_lock().is_ok());
+        session.owner_runtime.with_live(|| Ok(())).expect("failure did not fabricate shutdown");
+        assert_eq!(attempts.get(), 1);
+    }
+
+    #[tokio::test]
+    async fn unpolled_spawn_scope_retirement_cannot_leave_live_runtime_authority() {
+        let (session, _) = crate::session::tests::make_session_and_context().await;
+        let enrolled = session.owner_runtime.exit_guard();
+        let unpolled_loop = async move {
+            let _exit = enrolled;
+            std::future::pending::<()>().await;
+        };
+        drop(unpolled_loop);
+        let commits = Cell::new(0);
+        let result = session.owner_runtime.with_live(|| { commits.set(commits.get() + 1); Ok(()) });
+        assert_eq!(result.unwrap_err().kind(), std::io::ErrorKind::ConnectionAborted);
+        assert_eq!(commits.get(), 0);
+    }
+}
