 use codex_rollout::state_db::StateDbHandle;
 
+// Actual Session lifecycle, not a caller-supplied running claim. Teardown
+// marks Stopped before any native shutdown await; the short final owner commit
+// holds this same mutex without awaiting any writer, activity, or map operation.
+pub(crate) struct NativeRuntime {
+    state: std::sync::Mutex<NativeRuntimeState>,
+}
+
+#[derive(Clone, Copy)]
+enum NativeRuntimeState {
+    Live,
+    Stopped,
+}
+
+impl Default for NativeRuntime {
+    fn default() -> Self {
+        Self { state: std::sync::Mutex::new(NativeRuntimeState::Live) }
+    }
+}
+
+impl NativeRuntime {
+    pub(crate) fn stop(&self) {
+        let mut state = self.state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        *state = NativeRuntimeState::Stopped;
+    }
+
+    fn with_live<F>(&self, commit: F) -> std::io::Result<()>
+    where
+        F: FnOnce() -> std::io::Result<()>,
+    {
+        let state = self.state.lock().map_err(|_| {
+            std::io::Error::other("native runtime lifecycle unavailable")
+        })?;
+        if !matches!(*state, NativeRuntimeState::Live) {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::ConnectionAborted,
+                "native runtime has stopped",
+            ));
+        }
+        let result = commit();
+        drop(state);
+        result
+    }
+
+    pub(crate) fn exit_guard(self: &Arc<Self>) -> NativeRuntimeExit {
+        NativeRuntimeExit(Arc::clone(self))
+    }
+}
+
+pub(crate) struct NativeRuntimeExit(Arc<NativeRuntime>);
+impl Drop for NativeRuntimeExit {
+    fn drop(&mut self) {
+        self.0.stop();
+    }
+}
