+//! Prospective account-scoped SIWC model metadata. Credentials remain daemon-owned.
+use crate::auth_broker::{BrokerBinding, Lease};
+use crate::broker_request_profile::{RequestProfile, SIWC_PROFILE, SIWC_AUDIENCE};
+use crate::config::Config;
+use codex_http_client::HttpClientFactory;
+use codex_login::AuthManager;
+use codex_models_manager::manager::{ModelsManager, ModelsManagerFuture, RefreshStrategy, SharedModelsManager};
+use codex_protocol::config_types::CollaborationModeMask;
+use codex_protocol::openai_models::{ModelInfo, ModelPreset, ModelVisibility, ModelsResponse};
+use serde::Deserialize;
+use serde_json::Value;
+use std::collections::{HashMap, HashSet};
+use std::fmt;
+use std::io;
+use std::path::PathBuf;
+use std::sync::{Arc, Mutex, OnceLock, Weak};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::{SystemTime, UNIX_EPOCH};
+use tokio::sync::{RwLock, TryLockError};
+
+fn refused() -> io::Error { io::Error::other("SIWC account model catalog is unavailable or changed") }
+fn now() -> io::Result<u64> { SystemTime::now().duration_since(UNIX_EPOCH).map(|t|t.as_secs()).map_err(|_|refused()) }
+fn opaque(value: &str) -> bool { value.len()==64 && value.bytes().all(|b|b.is_ascii_digit() || (b'a'..=b'f').contains(&b)) && value.bytes().any(|b|b!=b'0') }
+
+#[derive(Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ModelRow { slug:String, display_name:String, visibility:String }
+#[derive(Clone, Copy, PartialEq, Eq, Deserialize)]
+#[serde(rename_all="snake_case")]
+enum ObservationStatus { Known, Unknown }
+#[derive(Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Catalog {
+    observation_status:ObservationStatus,
+    request_profile:String, audience:String, catalog_binding:String, expires_at:u64,
+    account_id:String, lease_handle:Option<String>, route_generation:Option<u64>, models:Vec<ModelRow>,
+}
+impl Catalog {
+    fn accept(value:Value, start:u64, lease:Option<&Lease>) -> io::Result<Self> {
+        if serde_json::to_vec(&value).map_err(|_|refused())?.len()>128*1024 { return Err(refused()); }
+        let object=value.as_object().ok_or_else(refused)?;
+        let keys=["observation_status","request_profile","audience","catalog_binding","expires_at","account_id","lease_handle","route_generation","models"];
+        if object.len()!=keys.len() || !keys.iter().all(|k|object.contains_key(*k))
+            || !value.get("models").and_then(Value::as_array).is_some_and(|rows|rows.iter().all(Value::is_object))
+        { return Err(refused()); }
+        let catalog:Self=serde_json::from_value(value).map_err(|_|refused())?;
+        if catalog.request_profile!=SIWC_PROFILE || catalog.audience!=SIWC_AUDIENCE
+            || !opaque(&catalog.catalog_binding) || !opaque(&catalog.account_id)
+            || catalog.expires_at<=now()? || catalog.expires_at>start.checked_add(60).ok_or_else(refused)?
+            || catalog.models.len()>256
+            || (catalog.observation_status==ObservationStatus::Known && catalog.models.is_empty())
+            || (catalog.observation_status==ObservationStatus::Unknown && !catalog.models.is_empty()) { return Err(refused()); }
+        if let Some(lease)=lease {
+            if catalog.lease_handle.as_deref()!=Some(lease.lease_handle.as_str())
+                || catalog.route_generation!=Some(lease.route_generation) || catalog.account_id!=lease.account_id
+                || catalog.expires_at>lease.expires_at { return Err(refused()); }
+        } else if catalog.lease_handle.is_some() || catalog.route_generation.is_some() { return Err(refused()); }
+        let mut seen=HashSet::new();
+        for row in &catalog.models {
+            if row.visibility!="list" || row.slug.is_empty() || row.slug.len()>128
+                || !row.slug.bytes().all(|b|(0x20..=0x7e).contains(&b))
+                || row.display_name.is_empty() || row.display_name.len()>256 || row.display_name.chars().any(char::is_control)
+                || !seen.insert(row.slug.clone()) { return Err(refused()); }
+        }
+        Ok(catalog)
+    }
+    fn models(&self) -> io::Result<Vec<ModelInfo>> {
+        if self.observation_status!=ObservationStatus::Known || self.expires_at<=now()? { return Err(refused()); }
+        Ok(self.models.iter().enumerate().map(|(index,row)| {
+            // Local native instructions/defaults are metadata, not a bundled
+            // vendor model catalog or an inference entitlement assertion.
+            let mut info=codex_models_manager::model_info::model_info_from_slug(&row.slug);
+            info.display_name=row.display_name.clone(); info.visibility=ModelVisibility::List; info.priority=index as i32;
+            info.context_window=None;info.max_context_window=None;info.auto_compact_token_limit=None;
+            info.supported_reasoning_levels.clear();info.default_reasoning_level=None;
+            info.supports_reasoning_summary_parameter=false;
+            info.default_reasoning_summary=codex_protocol::config_types::ReasoningSummary::None;
+            info.input_modalities=vec![codex_protocol::openai_models::InputModality::Text];
+            info.used_fallback_model_metadata=true;
+            info
+        }).collect())
+    }
+}
+
+type Key=(PathBuf,PathBuf);
+struct State { channel:Arc<BrokerBinding>, snapshot:RwLock<Option<Catalog>>, observation:AtomicU64 }
+impl State {
+    async fn begin(&self)->io::Result<u64> {
+        let previous=match self.observation.fetch_update(Ordering::SeqCst,Ordering::SeqCst,|v|v.checked_add(1).filter(|next|*next<u64::MAX)) {
+            Ok(previous)=>previous,
+            Err(_)=>{self.observation.store(u64::MAX,Ordering::SeqCst);*self.snapshot.write().await=None;return Err(refused());},
+        };
+        let operation=previous+1;
+        *self.snapshot.write().await=None;
+        Ok(operation)
+    }
+    async fn publish(&self,operation:u64,catalog:Option<Catalog>) {
+        let mut saved=self.snapshot.write().await;
+        if self.observation.load(Ordering::SeqCst)==operation {*saved=catalog;}
+    }
+}
+static CATALOGS:OnceLock<Mutex<HashMap<Key,Weak<State>>>>=OnceLock::new();
+fn registry() -> &'static Mutex<HashMap<Key,Weak<State>>> { CATALOGS.get_or_init(Mutex::default) }
+fn state(config:codex_config::config_toml::OmuxBrokerConfig) -> io::Result<Arc<State>> {
+    let key=(config.broker_socket.clone(),config.capability_path.clone());
+    let mut map=registry().lock().map_err(|_|refused())?;
+    map.retain(|_,value|value.strong_count()>0);
+    if let Some(state)=map.get(&key).and_then(Weak::upgrade) { return Ok(state); }
+    if map.len()>=16 { return Err(refused()); }
+    let state=Arc::new(State {channel:BrokerBinding::catalog_channel(config),snapshot:RwLock::new(None),observation:AtomicU64::new(0)});
+    map.insert(key,Arc::downgrade(&state)); Ok(state)
+}
+fn for_binding(binding:&BrokerBinding) -> io::Result<Arc<State>> {
+    registry().lock().map_err(|_|refused())?.get(&binding.catalog_key()).and_then(Weak::upgrade).ok_or_else(refused)
+}
