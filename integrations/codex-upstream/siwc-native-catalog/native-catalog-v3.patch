+/// Saved model metadata does not authorize a request or invent entitlement.
+/// Only the selected thread/read result may supply this startup preference.
+pub(crate) fn config_with_siwc_saved_model(
+    config:&Config, expected:ThreadId, actual:&str, model:Option<String>,
+)->std::io::Result<Config> {
+    if actual!=expected.to_string() {return Err(std::io::Error::other("saved model belongs to another native thread"));}
+    let mut observed=config.clone();
+    if codex_core::configured_siwc_broker(config) && observed.model.is_none() {observed.model=model;}
+    Ok(observed)
+}
+
+fn apply_siwc_saved_resume_settings(
+    params:&mut ThreadResumeParams, expected:ThreadId, actual:&str,
+    model:Option<String>, effort:Option<codex_protocol::openai_models::ReasoningEffort>,
+)->std::io::Result<()> {
+    if params.thread_id!=expected.to_string() || actual!=expected.to_string() {
+        return Err(std::io::Error::other("saved resume settings belong to another native thread"));
+    }
+    // The provider override would otherwise suppress server-side saved settings.
+    params.model=model;
+    let overrides=params.config.get_or_insert_with(HashMap::new);
+    if let Some(effort)=effort {
+        overrides.insert("model_reasoning_effort".into(),serde_json::Value::String(effort.to_string()));
+    } else {overrides.insert("model_reasoning_effort".into(),serde_json::Value::Null);}
+    if overrides.is_empty() {params.config=None;}
+    Ok(())
+}
