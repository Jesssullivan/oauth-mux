+pub(crate) fn selected(config:&Config) -> bool {
+    config.auth_broker_configured() && RequestProfile::for_provider(&config.model_provider).is_ok_and(|p|p==RequestProfile::SiwcResponses)
+}
+pub(crate) fn manager(config:&Config) -> SharedModelsManager {
+    let retained=if selected(config) { config.omux_broker_config().ok().flatten().and_then(|cfg|state(cfg).ok()) } else {None};
+    Arc::new(BrokerModelsManager {state:retained})
+}
+struct BrokerModelsManager { state:Option<Arc<State>> }
+impl fmt::Debug for BrokerModelsManager {
+    fn fmt(&self,f:&mut fmt::Formatter<'_>)->fmt::Result { f.write_str("SIWC account-scoped catalog manager (redacted)") }
+}
+impl BrokerModelsManager {
+    async fn fetch(&self) -> io::Result<Vec<ModelInfo>> {
+        let state=self.state.as_ref().ok_or_else(refused)?;
+        let previous=state.snapshot.read().await.as_ref().filter(|s|now().is_ok_and(|n|s.expires_at>n)).map(|s|s.catalog_binding.clone());
+        let operation=state.begin().await?;
+        let start=now()?;
+        let result=state.channel.catalog_bootstrap(previous.as_deref()).await.and_then(|value|Catalog::accept(value,start,None));
+        match result {
+            Ok(catalog)=>match catalog.models() {
+                Ok(models)=>{state.publish(operation,Some(catalog)).await;Ok(models)},
+                Err(error)=>{state.publish(operation,None).await;Err(error)},
+            },
+            Err(error)=>{state.publish(operation,None).await;Err(error)},
+        }
+    }
+}
+impl ModelsManager for BrokerModelsManager {
+    fn enter_broker_descriptive_mode(&self) {}
+    fn is_broker_descriptive(&self)->bool { true }
+    fn filters_catalog_by_native_auth(&self)->bool { false }
+    fn build_available_models(&self,mut models:Vec<ModelInfo>)->Vec<ModelPreset> {
+        // Use this exact returned account observation, never a concurrent
+        // process-wide snapshot from a different prospective account.
+        models.sort_by_key(|m|m.priority);
+        let mut presets:Vec<ModelPreset>=models.into_iter().map(Into::into).collect();
+        ModelPreset::mark_default_by_picker_visibility(&mut presets);
+        presets
+    }
+    fn broker_catalog_models(&self)->Vec<ModelInfo> { self.try_get_remote_models().unwrap_or_default() }
+    fn broker_account_models(&self)->Option<ModelsManagerFuture<'_,io::Result<Vec<ModelPreset>>>> {
+        Some(Box::pin(async move {self.fetch().await.map(|models|self.build_available_models(models))}))
+    }
+    fn raw_model_catalog(&self,_strategy:RefreshStrategy,_factory:HttpClientFactory)->ModelsManagerFuture<'_,ModelsResponse> {
+        Box::pin(async move {ModelsResponse {models:self.fetch().await.unwrap_or_default()}})
+    }
+    fn get_remote_models(&self)->ModelsManagerFuture<'_,Vec<ModelInfo>> {
+        Box::pin(async move {
+            let Some(state)=&self.state else {return Vec::new()};
+            state.snapshot.read().await.as_ref().and_then(|catalog|catalog.models().ok()).unwrap_or_default()
+        })
+    }
+    fn try_get_remote_models(&self)->Result<Vec<ModelInfo>,TryLockError> {
+        let Some(state)=&self.state else {return Ok(Vec::new())};
+        Ok(state.snapshot.try_read()?.as_ref().and_then(|catalog|catalog.models().ok()).unwrap_or_default())
+    }
+    fn auth_manager(&self)->Option<&AuthManager> { None }
+    fn list_collaboration_modes(&self)->Vec<CollaborationModeMask> {
+        codex_models_manager::collaboration_mode_presets::builtin_collaboration_mode_presets()
+    }
+    fn refresh_if_new_etag(&self,_etag:String,_factory:HttpClientFactory)->ModelsManagerFuture<'_,()> {
+        Box::pin(async move {
+            if self.fetch().await.is_err() { tracing::warn!("SIWC model metadata refresh unavailable"); }
+        })
+    }
+}
+
+/// Preserve an explicit or resumed model. When no model was selected, require
+/// the actual prospective account catalog rather than inventing a vendor default.
+pub(crate) async fn initial_model(manager:&SharedModelsManager,configured:&Option<String>)->io::Result<Option<String>> {
+    let Some(account_catalog)=manager.broker_account_models() else {return Ok(None)};
+    if let Some(model)=configured {return Ok(Some(model.clone()));}
+    let models=account_catalog.await?;
+    models.iter().find(|model|model.is_default).or(models.first())
+        .map(|model|Some(model.model.clone())).ok_or_else(refused)
+}
+
+pub(crate) struct RequestCatalogObservation { account_id:String, lease_handle:String, route_generation:u64, expires_at:u64 }
+impl RequestCatalogObservation {
+    pub(crate) fn check(&self,lease:&Lease)->io::Result<bool> {
+        if self.account_id!=lease.account_id || self.lease_handle!=lease.lease_handle
+            || self.route_generation!=lease.route_generation || lease.expires_at<=now()? || self.expires_at>lease.expires_at
+        { return Err(refused()); }
+        Ok(self.expires_at>now()?)
+    }
+}
+
+pub(crate) async fn prepare_request(binding:&BrokerBinding,lease:&Lease,model:&str)->io::Result<Option<RequestCatalogObservation>> {
+    // Metadata is an observation, never an additional grant/readiness authority.
+    // Clear the previous account before a new issued-account observation.
+    let state=for_binding(binding).ok();
+    let operation=if let Some(state)=&state {state.begin().await.ok()} else {None};
+    let start=now()?;
+    let result=binding.catalog_for_lease(lease).await.and_then(|v|Catalog::accept(v,start,Some(lease)));
+    let catalog=match result {
+        Ok(catalog)=>catalog,
+        Err(_)=>{return Ok(None)}, // bounded failure/malformed/stale metadata is Unknown
+    };
+    if catalog.observation_status==ObservationStatus::Unknown {return Ok(None);}
+    let present=catalog.models.iter().any(|m|m.slug==model);
+    let observation=RequestCatalogObservation {account_id:catalog.account_id.clone(),lease_handle:lease.lease_handle.clone(),
+        route_generation:lease.route_generation,expires_at:catalog.expires_at};
+    if let (Some(state),Some(operation))=(state,operation) {state.publish(operation,Some(catalog)).await;}
+    if !observation.check(lease)? {return Ok(None);}
+    if !present {return Err(io::Error::other("model is not listed by the issued SIWC account"));}
+    Ok(Some(observation))
+}
