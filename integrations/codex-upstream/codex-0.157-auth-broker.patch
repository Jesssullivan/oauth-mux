+mod broker_detach_admission_tests {
+    use super::super::admit_broker_attach;
+    use super::super::admit_broker_detach;
+    use codex_app_server_protocol::ThreadStatus;
+    use codex_protocol::protocol::AgentStatus;
+    use pretty_assertions::assert_eq;
+    use serde_json::json;
+
+    #[test]
+    fn attachment_requires_idle_thread_and_stopped_native_realtime() {
+        assert_eq!(
+            admit_broker_attach(ThreadStatus::Idle, AgentStatus::Completed(None), false),
+            Ok(())
+        );
+        for (status, agent) in [
+            (ThreadStatus::NotLoaded, AgentStatus::Completed(None)),
+            (ThreadStatus::Idle, AgentStatus::Running),
+        ] {
+            assert_eq!(
+                admit_broker_attach(status, agent, false)
+                    .expect_err("active native streams cannot attach")
+                    .message,
+                "auth broker attachment requires an idle native thread"
+            );
+        }
+        assert_eq!(
+            admit_broker_attach(ThreadStatus::Idle, AgentStatus::Completed(None), true)
+                .expect_err("an accepted realtime connection cannot attach")
+                .message,
+            "auth broker attachment requires the native realtime conversation to stop"
+        );
+    }
+
+    #[test]
+    fn detachment_requires_idle_watch_and_nonrunning_agent() {
+        for (status, agent) in [
+            (ThreadStatus::NotLoaded, AgentStatus::Completed(None)),
+            (ThreadStatus::SystemError, AgentStatus::Completed(None)),
+            (
+                ThreadStatus::Active {
+                    active_flags: Vec::new(),
+                },
+                AgentStatus::Completed(None),
+            ),
+            (ThreadStatus::Idle, AgentStatus::Running),
+        ] {
+            let result = admit_broker_detach(status, agent, std::iter::empty());
+            assert_eq!(
+                result.expect_err("detachment must wait").message,
+                "auth broker detachment requires an idle native thread"
+            );
+        }
+        assert_eq!(
+            admit_broker_detach(
+                ThreadStatus::Idle,
+                AgentStatus::Completed(None),
+                std::iter::once(Ok(
+                    json!({"type":"message","content":"retained native text"})
+                ))
+            ),
+            Ok(())
+        );
+    }
+
+    #[test]
+    fn idle_detachment_preserves_opaque_context_and_rejects_uninspectable_history() {
+        for context in [
+            json!({"encrypted_content":"opaque fixture"}),
+            json!({"image":{"file_id":"opaque fixture"}}),
+        ] {
+            let result = admit_broker_detach(
+                ThreadStatus::Idle,
+                AgentStatus::Completed(None),
+                std::iter::once(Ok(context)),
+            );
+            assert_eq!(
+                result
+                    .expect_err("account-bound native context cannot detach")
+                    .message,
+                "native context contains account-bound data; auth broker cannot be detached"
+            );
+        }
+        let invalid_history = serde_json::from_str::<serde_json::Value>("{invalid native context");
+        let result = admit_broker_detach(
+            ThreadStatus::Idle,
+            AgentStatus::Completed(None),
+            std::iter::once(invalid_history),
+        );
+        assert_eq!(
+            result
+                .expect_err("uninspectable context cannot detach")
+                .message,
+            "native context could not be inspected for detachment"
+        );
+    }
+}
