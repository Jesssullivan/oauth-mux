+        self.status_account_display = self.status_account_display_for_new_thread();
+    }
+
+    pub(crate) fn apply_broker_account_status(
+        &mut self,
+        status: &codex_app_server_protocol::OmuxBrokerThreadStatusResponse,
+    ) {
+        if self.thread_id.map(|id| id.to_string()).as_deref() != Some(status.thread_id.as_str()) {
+            return;
+        }
+        if !status.bound {
+            self.restore_native_account_state();
+            return;
+        }
+        if !self.broker_account_managed() {
+            self.native_account_display_state = Some(NativeAccountDisplayState {
+                display: self.status_account_display.clone(),
+                plan_type: self.plan_type,
+                has_chatgpt_account: self.has_chatgpt_account,
+                has_codex_backend_auth: self.has_codex_backend_auth,
+            });
+        }
+        let display = StatusAccountDisplay::BrokerManaged {
+            endpoint_configured: true,
+            route: status
+                .last_observed_route
+                .as_ref()
+                .and_then(crate::status::BrokerAccountMetadata::from_cached_route),
+        };
+        if self.status_account_display.as_ref() != Some(&display)
+            || self.plan_type.is_some()
+            || self.has_chatgpt_account
+            || self.has_codex_backend_auth
+        {
+            self.update_account_state(Some(display), None, false, false);
+        }
+    }
+
+    pub(crate) fn restore_native_account_state(&mut self) {
+        if let Some(native) = self.native_account_display_state.take() {
+            self.update_account_state(
+                native.display,
+                native.plan_type,
+                native.has_chatgpt_account,
+                native.has_codex_backend_auth,
+            );
+        }
+    }
+
+    /// Global account notifications may update the native source, but cannot replace the
+    /// selected thread's broker route display or carry native quota into that thread.
+    pub(crate) fn update_native_account_state(
+        &mut self,
+        status_account_display: Option<StatusAccountDisplay>,
+        plan_type: Option<PlanType>,
+        has_chatgpt_account: bool,
+        has_codex_backend_auth: bool,
+    ) {
+        if self.broker_account_managed() {
+            if self.native_account_display_state.is_some() {
+                self.native_account_display_state = Some(NativeAccountDisplayState {
+                    display: status_account_display,
+                    plan_type,
+                    has_chatgpt_account,
+                    has_codex_backend_auth,
+                });
+            }
+            return;
+        }
+        self.update_account_state(
+            status_account_display,
+            plan_type,
+            has_chatgpt_account,
+            has_codex_backend_auth,
+        );
     }
 
