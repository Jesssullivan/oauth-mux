+    std::fs::create_dir(&private_dir)?;
+    std::fs::set_permissions(&private_dir, std::fs::Permissions::from_mode(0o700))?;
+    let socket = private_dir.join("adapter.sock");
+    let _listener = tokio::net::UnixListener::bind(&socket)?;
+    std::fs::set_permissions(&socket, std::fs::Permissions::from_mode(0o600))?;
+    let capability = private_dir.join("adapter.capability");
+    // Deliberately synthetic local capability, never an enrolled credential.
+    std::fs::write(&capability, "0".repeat(64))?;
+    std::fs::set_permissions(&capability, std::fs::Permissions::from_mode(0o600))?;
+    let thread_id = ThreadId::new();
+    assert!(native_auth_allowed(&config, thread_id));
+    codex_core::auth_broker::register(thread_id, socket, capability, thread_id.to_string()).await?;
+    let bound_allowed = native_auth_allowed(&config, thread_id);
+    codex_core::auth_broker::unregister(thread_id, false);
+    let detached_allowed = native_auth_allowed(&config, thread_id);
+    codex_core::auth_broker::forget(thread_id);
+
+    assert!(!bound_allowed);
+    assert!(!detached_allowed);
+    assert!(native_auth_allowed(&config, thread_id));
