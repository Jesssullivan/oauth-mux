 use wiremock::matchers::query_param;
 
 const MAX_CAPABILITY_SUMMARY_DESCRIPTION_LEN: usize = 1024;
+
+#[tokio::test]
+async fn broker_plugin_adoption_drains_remote_auth_and_preserves_local_skills() {
+    let home = TempDir::new().expect("create home");
+    write_plugin(
+        &home.path().join("plugins/cache/test"),
+        "sample/local",
+        "sample",
+    );
+    let manager = Arc::new(test_plugins_manager_with_options(
+        home.path().to_path_buf(),
+        Some(Product::Codex),
+        Some(AuthMode::Chatgpt),
+    ));
+    let config = plugins_config_input_with_requirements(
+        home.path(),
+        &plugin_config_toml(true, true),
+        "[marketplaces]\nrestrict_to_allowed_sources = false",
+    );
+    let (started_tx, started_rx) = tokio::sync::oneshot::channel();
+    let (dropped_tx, dropped_rx) = tokio::sync::oneshot::channel();
+    struct DropSignal(Option<tokio::sync::oneshot::Sender<()>>);
+    impl Drop for DropSignal {
+        fn drop(&mut self) {
+            if let Some(sender) = self.0.take() {
+                let _ = sender.send(());
+            }
+        }
+    }
+    manager.spawn_native_remote_task(async move {
+        let _guard = DropSignal(Some(dropped_tx));
+        let _ = started_tx.send(());
+        std::future::pending::<()>().await;
+    });
+    started_rx.await.expect("remote task started");
+    manager.await_broker_local_only().await;
+    dropped_rx
+        .await
+        .expect("copied auth dropped before acknowledgement");
+    assert_eq!(manager.auth_mode(), None);
+    let plugins = manager.plugins_for_config(&config).await;
+    assert_eq!(plugins.plugins().len(), 1);
+    assert!(manager.plugin_skill_snapshots_for_config(&config).is_some());
+    assert!(!manager.remote_global_catalog_active(&config));
+}
+
+#[tokio::test]
+async fn broker_plugin_config_presence_blocks_remote_work_even_when_malformed() {
+    let home = TempDir::new().expect("create home");
+    let manager = Arc::new(test_plugins_manager_with_options(
+        home.path().to_path_buf(),
+        Some(Product::Codex),
+        Some(AuthMode::Chatgpt),
+    ));
+    let config = plugins_config_input_with_requirements(
+        home.path(),
+        "omux_broker = false",
+        "[marketplaces]\nrestrict_to_allowed_sources = false",
+    );
+    manager.maybe_start_remote_plugin_caches_refresh(&config, None, None);
+    assert!(manager.is_broker_local_only());
+    assert_eq!(manager.auth_mode(), None);
+    assert!(
+        manager
+            .broker_remote_tasks
+            .lock()
+            .expect("task registry")
+            .is_empty()
+    );
+    let mut polled = false;
+    assert!(
+        manager
+            .native_remote_work(async {
+                polled = true;
+            })
+            .await
+            .is_none()
+    );
+    assert!(!polled);
+    assert!(
+        manager
+            .featured_plugin_ids_for_config(&config, None)
+            .await
+            .expect("local-only featured plugins")
+            .is_empty()
+    );
+}
 
