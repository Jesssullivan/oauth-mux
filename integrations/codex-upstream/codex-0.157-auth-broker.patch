+    let socket = private_dir.join("adapter.sock");
+    let _listener = tokio::net::UnixListener::bind(&socket)?;
+    std::fs::set_permissions(&socket, std::fs::Permissions::from_mode(0o600))?;
+    let capability = private_dir.join("adapter.capability");
+    // A synthetic, private test capability; no provider credential is loaded.
