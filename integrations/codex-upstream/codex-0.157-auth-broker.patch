+}
+
+#[test]
+fn broker_capabilities_and_registration_responses_preserve_wire_contract() -> Result<()> {
+    let capabilities = v2::OmuxBrokerCapabilities {
+        protocol_version: 1,
+        late_thread_binding: true,
+        per_request_auth: true,
+        exclusive_refresh_owner: true,
+        preacceptance_failure: true,
+        account_transport_invalidation: true,
+        native_context_reconstruction: false,
+    };
+    let capabilities_wire = json!({
+        "protocol_version":1,"late_thread_binding":true,"per_request_auth":true,
+        "exclusive_refresh_owner":true,"preacceptance_failure":true,
+        "account_transport_invalidation":true,"native_context_reconstruction":false,
+    });
+    let response = v2::OmuxBrokerCapabilitiesResponse {
+        protocol_version: 1,
+        capabilities: capabilities.clone(),
+    };
+    let response_wire = json!({"protocolVersion":1,"capabilities":capabilities_wire});
+    assert_eq!(serde_json::to_value(&response)?, response_wire);
+    assert_eq!(
+        serde_json::from_value::<v2::OmuxBrokerCapabilitiesResponse>(response_wire)?,
+        response
+    );
+    let registered = v2::OmuxBrokerRegisterResponse {
+        binding_id: "binding-fixture".into(),
+        protocol_version: 1,
+        refresh_ownership_acknowledged: true,
+        capabilities,
+    };
+    let registered_wire = json!({
+        "bindingId":"binding-fixture","protocolVersion":1,
+        "refreshOwnershipAcknowledged":true,"capabilities":capabilities_wire,
+    });
+    assert_eq!(serde_json::to_value(&registered)?, registered_wire);
+    assert_eq!(
+        serde_json::from_value::<v2::OmuxBrokerRegisterResponse>(registered_wire)?,
+        registered
+    );
+    assert_eq!(
+        serde_json::to_value(v2::OmuxBrokerUnregisterResponse { unregistered: true })?,
+        json!({"unregistered":true})
+    );
+    Ok(())
+}
