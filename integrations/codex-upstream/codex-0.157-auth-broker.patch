+/// Display-only fields from the selected thread's last observed broker route.
+/// Credential handles, provider identity and renewal authority stay out of the TUI.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct BrokerAccountMetadata {
+    pub(crate) account_label: Option<String>,
+    pub(crate) account_type: Option<String>,
+    pub(crate) provider: Option<String>,
+    pub(crate) provider_expires_at: Option<i64>,
+    pub(crate) custody_expires_at: Option<i64>,
+    pub(crate) observed_at: Option<i64>,
+}
+
+impl BrokerAccountMetadata {
+    pub(crate) fn from_cached_route(value: &serde_json::Value) -> Option<Self> {
+        let object = value.as_object()?;
+        let metadata = Self {
+            account_label: safe_display_text(object.get("account_label"), 80),
+            account_type: safe_display_text(object.get("account_type"), 48),
+            provider: safe_display_text(object.get("provider"), 48),
+            provider_expires_at: safe_timestamp(object.get("provider_expires_at")),
+            custody_expires_at: safe_timestamp(object.get("custody_expires_at")),
+            observed_at: safe_timestamp(object.get("observed_at")),
+        };
+        if metadata.account_label.is_none()
+            && metadata.account_type.is_none()
+            && metadata.provider.is_none()
+            && metadata.provider_expires_at.is_none()
+            && metadata.custody_expires_at.is_none()
+            && metadata.observed_at.is_none()
+        {
+            None
+        } else {
+            Some(metadata)
+        }
+    }
+}
+
+fn safe_display_text(value: Option<&serde_json::Value>, max_bytes: usize) -> Option<String> {
+    let text = value?.as_str()?;
+    // Reject before trimming so a leading newline or terminal escape is not concealed.
+    if text.len() > max_bytes
+        || !text
+            .chars()
+            .all(|character| character.is_alphanumeric() || " -_().".contains(character))
+    {
+        return None;
+    }
+    let text = text.trim();
+    if text.is_empty()
+        || !text.chars().any(char::is_alphabetic)
+        || text.split(' ').any(|word| word.len() > 32)
+        || text.split('.').count() > 2
+    {
+        return None;
+    }
+    Some(text.to_owned())
+}
+
+fn safe_timestamp(value: Option<&serde_json::Value>) -> Option<i64> {
+    let seconds = value?.as_i64()?;
+    // Keep numeric fields within ordinary Unix-date display bounds.
+    (0..=253_402_300_799).contains(&seconds).then_some(seconds)
+}
