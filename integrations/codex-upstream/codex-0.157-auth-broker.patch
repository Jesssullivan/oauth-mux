+#[test]
+fn native_detach_defaults_to_release_while_coordinated_detach_can_skip_it() -> Result<()> {
+    let default: v2::OmuxBrokerUnregisterParams =
+        serde_json::from_value(json!({"threadId":"thread-fixture"}))?;
+    assert_eq!(default.release_binding.unwrap_or(true), true);
+    let coordinated: v2::OmuxBrokerUnregisterParams = serde_json::from_value(json!({
+        "threadId":"thread-fixture","releaseBinding":false,
+    }))?;
+    assert_eq!(coordinated.release_binding.unwrap_or(true), false);
+    Ok(())
+}
+
+#[test]
+fn broker_thread_status_serializes_explicitly_nullable_cached_metadata() -> Result<()> {
+    for last_observed_route in [None, Some(json!({"observed_at":123,"route_generation":7}))] {
+        let response = v2::OmuxBrokerThreadStatusResponse {
+            thread_id: "thread-fixture".into(),
+            bound: last_observed_route.is_some(),
+            last_observed_route: last_observed_route.clone(),
+        };
+        let wire = json!({
+            "threadId":"thread-fixture","bound":last_observed_route.is_some(),
+            "lastObservedRoute":last_observed_route,
+        });
+        assert_eq!(serde_json::to_value(&response)?, wire);
+        assert_eq!(
