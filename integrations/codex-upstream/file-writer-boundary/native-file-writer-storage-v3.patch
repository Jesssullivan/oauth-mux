+++ b/codex-rs/login/src/auth/managed_file_writer.rs
@@ -0,0 +1,779 @@
+//! Disabled, Linux-only original File writer storage boundary.
+//!
+//! There is deliberately no production enrollment/admission/successor constructor,
+//! owner RPC, issuer or scheduler. Tests alone can construct the prerequisites.
+//! A cooperating File lock does not exclude an unmodified writer. A future native
+//! trust binding and all issuer paths must be qualified before this can be enabled.
+//!
+//! Keep error strings and Debug output free of native auth, keys and identity.
+
+use std::io;
+use std::path::Path;
+
+/// A legacy backend cannot adopt authority from a sidecar. If it encounters a
+/// writer directory, refuse before side effects; do not swallow that refusal in
+/// keyring cleanup/fallback. Absence is not a managed-enrollment constructor.
+pub(super) fn reject_unbound_mutation(home: &Path) -> io::Result<()> {
+    match std::fs::symlink_metadata(home.join(".omux-native-file-writer")) {
+        Ok(_) => Err(io::Error::other("native File writer binding required")),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(()),
+        Err(_) => Err(io::Error::other("native File writer state unavailable")),
+    }
+}
+
+#[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+pub(super) use linux::*;
+
+#[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+#[allow(dead_code)] // Prerequisite only: no production authority constructor yet.
+mod linux {
+    use super::*;
+    use super::super::storage::AuthDotJson;
+    use codex_protocol::auth::AuthMode;
+    use hmac::Hmac;
+    use hmac::Mac;
+    use serde::Deserialize;
+    use serde::Serialize;
+    use sha2::Sha256;
+    use std::ffi::CString;
+    use std::ffi::OsStr;
+    use std::fs::File;
+    use std::fs::Metadata;
+    use std::fs::TryLockError;
+    use std::io::Read;
+    use std::io::Write;
+    use std::os::fd::AsRawFd;
+    use std::os::fd::FromRawFd;
+    use std::os::unix::ffi::OsStrExt;
+    use std::os::unix::fs::MetadataExt;
+    use std::path::Component;
+    use std::path::PathBuf;
+    use std::sync::Arc;
+    use std::time::Instant;
+    use zeroize::Zeroize;
+    use zeroize::Zeroizing;
+
+    const DIRECTORY: &str = ".omux-native-file-writer";
+    const LOCK: &str = "writer.lock";
+    const KEY: &str = "writer-capability";
+    const JOURNAL: &str = "writer-state.json";
+    const AUTH: &str = "auth.json";
+    const AUTH_LIMIT: usize = 131072;
+    const PAYLOAD_LIMIT: usize = 8192;
+    const JOURNAL_LIMIT: usize = 16384;
+    const MAGIC: &str = "omux-native-managed-file-writer-state-envelope-v1\n";
+    const MAC_DOMAIN: &[u8] = b"omux-native-managed-file-writer-state-v1\n";
+
+    fn invalid() -> io::Error {
+        io::Error::other("native File writer state unavailable")
+    }
+
+    fn require(value: bool) -> io::Result<()> {
+        if value { Ok(()) } else { Err(invalid()) }
+    }
+
+    fn deadline(until: Instant) -> io::Result<()> {
+        if Instant::now() < until { Ok(()) } else {
+            Err(io::Error::new(io::ErrorKind::TimedOut, "native File writer deadline"))
+        }
+    }
+
+    fn name(value: &OsStr) -> io::Result<CString> {
+        CString::new(value.as_bytes()).map_err(|_| invalid())
+    }
+
+    fn open(parent: i32, value: &OsStr, flags: i32) -> io::Result<File> {
+        let value = name(value)?;
+        // All callers use a held directory and a single validated component.
+        let fd = unsafe { libc::openat(parent, value.as_ptr(), flags | libc::O_CLOEXEC | libc::O_NOFOLLOW | libc::O_NONBLOCK, 0o600) };
+        if fd < 0 { return Err(io::Error::last_os_error()); }
+        Ok(unsafe { File::from_raw_fd(fd) })
+    }
+
+    fn directory(path: &Path) -> io::Result<File> {
+        require(path.is_absolute() && path.as_os_str().as_bytes().len() <= 4096)?;
+        let canonical: PathBuf = path.components().collect();
+        require(canonical.as_os_str() == path.as_os_str())?;
+        let mut current = open(libc::AT_FDCWD, OsStr::new("/"), libc::O_RDONLY | libc::O_DIRECTORY)?;
+        for part in path.components().skip(1) {
+            let Component::Normal(part) = part else { return Err(invalid()); };
+            current = open(current.as_raw_fd(), part, libc::O_RDONLY | libc::O_DIRECTORY)?;
+            let m = current.metadata()?;
+            #[cfg(test)]
+            let test_tmp = part == "tmp" && m.uid() == 0 && m.mode() & 0o1000 != 0;
+            #[cfg(not(test))]
+            let test_tmp = false;
+            require((m.uid() == 0 || m.uid() == unsafe { libc::getuid() }) && (m.mode() & 0o022 == 0 || test_tmp))?;
+        }
+        Ok(current)
+    }
+
+    // Full leaf witnesses fence replacement AND in-place changes. Directory
+    // witnesses are retained too; publication rebinds only after an exact owned
+    // leaf join and unchanged directory inode/ownership/mode/link count.
+    #[derive(Clone, PartialEq, Eq, Serialize, Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Witness {
+        device: String,
+        inode: String,
+        uid: String,
+        mode: String,
+        nlink: String,
+        bytes: String,
+        mtime_seconds: String,
+        mtime_nanoseconds: String,
+        ctime_seconds: String,
+        ctime_nanoseconds: String,
+    }
+
+    impl Witness {
+        fn from(m: &Metadata) -> Self {
+            Self { device: m.dev().to_string(), inode: m.ino().to_string(), uid: m.uid().to_string(), mode: m.mode().to_string(), nlink: m.nlink().to_string(), bytes: m.len().to_string(), mtime_seconds: m.mtime().to_string(), mtime_nanoseconds: m.mtime_nsec().to_string(), ctime_seconds: m.ctime().to_string(), ctime_nanoseconds: m.ctime_nsec().to_string() }
+        }
+
+        fn same_directory(&self, other: &Self) -> bool {
+            self.device == other.device && self.inode == other.inode && self.uid == other.uid && self.mode == other.mode && self.nlink == other.nlink
+        }
+
+        fn validate(&self) -> io::Result<()> {
+            for value in [&self.device, &self.inode, &self.uid, &self.mode, &self.nlink, &self.bytes] { decimal(value, false)?; }
+            for value in [&self.mtime_seconds, &self.ctime_seconds] {
+                let n: i64 = value.parse().map_err(|_| invalid())?;
+                require(n.to_string() == *value)?;
+            }
+            require(decimal(&self.mtime_nanoseconds, false)? <= 999999999 && decimal(&self.ctime_nanoseconds, false)? <= 999999999)
+        }
+    }
+
+    fn decimal(value: &str, nonzero: bool) -> io::Result<u64> {
+        let n: u64 = value.parse().map_err(|_| invalid())?;
+        require(n.to_string() == value && (!nonzero || n != 0))?;
+        Ok(n)
+    }
+
+    fn opaque(value: &str) -> io::Result<()> {
+        require(value.len() == 64 && value.bytes().all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c)) && value.bytes().any(|c| c != b'0'))
+    }
+
+    fn hex(raw: &[u8]) -> String {
+        const DIGITS: &[u8] = b"0123456789abcdef";
+        let mut out = String::with_capacity(raw.len() * 2);
+        for &value in raw { out.push(DIGITS[usize::from(value >> 4)] as char); out.push(DIGITS[usize::from(value & 15)] as char); }
+        out
+    }
+
+    fn decode(value: &[u8]) -> io::Result<[u8; 32]> {
+        require(value.len() == 64)?;
+        let mut out = [0; 32];
+        let nibble = |v: u8| -> io::Result<u8> { match v { b'0'..=b'9' => Ok(v - b'0'), b'a'..=b'f' => Ok(v - b'a' + 10), _ => Err(invalid()) } };
+        for (index, pair) in value.chunks_exact(2).enumerate() { out[index] = nibble(pair[0])? * 16 + nibble(pair[1])?; }
+        Ok(out)
+    }
+
+    fn mac(key: &[u8], domain: &[u8], data: &[u8]) -> io::Result<String> {
+        let mut h = Hmac::<Sha256>::new_from_slice(key).map_err(|_| invalid())?;
+        h.update(domain); h.update(data);
+        Ok(hex(&h.finalize().into_bytes()))
+    }
+
+    fn leaf(parent: &File, value: &str, flags: i32, max: usize) -> io::Result<File> {
+        let file = open(parent.as_raw_fd(), OsStr::new(value), flags)?;
+        let m = file.metadata()?;
+        require(m.is_file() && m.uid() == unsafe { libc::getuid() } && m.mode() & 0o7777 == 0o600 && m.nlink() == 1 && m.len() <= max as u64)?;
+        Ok(file)
+    }
+
+    fn read_leaf(parent: &File, value: &str, max: usize) -> io::Result<(File, Witness, Zeroizing<Vec<u8>>)> {
+        let mut file = leaf(parent, value, libc::O_RDONLY, max)?;
+        let before = Witness::from(&file.metadata()?);
+        let mut bytes = Zeroizing::new(Vec::with_capacity(max.min(4096)));
+        (&mut file).take(max as u64 + 1).read_to_end(&mut bytes)?;
+        require(bytes.len() <= max && bytes.len() as u64 == decimal(&before.bytes, false)?)?;
+        let named = leaf(parent, value, libc::O_RDONLY, max)?;
+        require(before == Witness::from(&file.metadata()?) && before == Witness::from(&named.metadata()?))?;
+        Ok((file, before, bytes))
+    }
+
+    struct BoundedBytes { bytes: Zeroizing<Vec<u8>>, limit: usize }
+    impl Write for BoundedBytes {
+        fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+            require(bytes.len() <= self.limit.saturating_sub(self.bytes.len()))?;
+            self.bytes.extend_from_slice(bytes); Ok(bytes.len())
+        }
+        fn flush(&mut self) -> io::Result<()> { Ok(()) }
+    }
+
+    fn serialize<T: Serialize>(value: &T, limit: usize) -> io::Result<Zeroizing<Vec<u8>>> {
+        let mut out = BoundedBytes { bytes: Zeroizing::new(Vec::new()), limit };
+        serde_json::to_writer(&mut out, value).map_err(|_| invalid())?;
+        Ok(out.bytes)
+    }
+
+    #[derive(Clone, PartialEq, Eq, Serialize, Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Enrollment { origin_id: String, enrollment_id: String, writer_protocol: String, capability_generation: String }
+
+    #[derive(Clone, PartialEq, Eq, Serialize, Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Predecessor {
+        context_id: String,
+        context_generation: String,
+        home_witness: Witness,
+        auth_witness: Witness,
+        auth_state_commitment: String,
+        identity_commitment: String,
+        manager_auth_generation: String,
+        manager_owner_generation: String,
+    }
+
+    #[derive(Clone, PartialEq, Eq, Serialize, Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Operation {
+        operation_id: String,
+        owner_id: String,
+        process_nonce: String,
+        endpoint_generation: String,
+        source_id: String,
+        source_generation: String,
+        consent_id: String,
+        consent_generation: String,
+        forget_epoch: String,
+        admitted_wall_time: String,
+    }
+
+    #[derive(Clone, PartialEq, Eq, Serialize, Deserialize)]
+    #[serde(rename_all = "snake_case")]
+    enum Phase { Clean, Issued, Uncertain }
+
+    #[derive(Clone, PartialEq, Eq, Serialize, Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Terminal {
+        operation_id: String,
+        status: String,
+        #[serde(deserialize_with = "required_nullable")]
+        successor_auth_witness: Option<Witness>,
+        #[serde(deserialize_with = "required_nullable")]
+        successor_auth_state_commitment: Option<String>,
+    }
+
+    fn required_nullable<'de, D: serde::Deserializer<'de>, T: Deserialize<'de>>(d: D) -> Result<Option<T>, D::Error> { Option::<T>::deserialize(d) }
+
+    #[derive(Clone, PartialEq, Eq, Serialize, Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Journal {
+        schema_version: u32,
+        kind: String,
+        sequence: String,
+        phase: Phase,
+        enrollment: Enrollment,
+        #[serde(deserialize_with = "required_nullable")]
+        predecessor: Option<Predecessor>,
+        #[serde(deserialize_with = "required_nullable")]
+        operation: Option<Operation>,
+        #[serde(deserialize_with = "required_nullable")]
+        last_terminal: Option<Terminal>,
+    }
+
+    impl Journal {
+        fn validate(&self, expected: &Enrollment) -> io::Result<()> {
+            require(self.schema_version == 1 && self.kind == "omux-native-managed-file-writer-state-v1" && &self.enrollment == expected)?;
+            decimal(&self.sequence, false)?;
+            opaque(&self.enrollment.origin_id)?; opaque(&self.enrollment.enrollment_id)?;
+            require(self.enrollment.writer_protocol == "omux-native-managed-file-writer-v1")?;
+            decimal(&self.enrollment.capability_generation, true)?;
+            require(match self.phase { Phase::Clean => self.predecessor.is_none() && self.operation.is_none(), Phase::Issued | Phase::Uncertain => self.predecessor.is_some() && self.operation.is_some() })?;
+            if let Some(p) = &self.predecessor {
+                opaque(&p.context_id)?; decimal(&p.context_generation, true)?;
+                p.home_witness.validate()?; p.auth_witness.validate()?;
+                opaque(&p.auth_state_commitment)?; opaque(&p.identity_commitment)?;
+                decimal(&p.manager_auth_generation, false)?; decimal(&p.manager_owner_generation, false)?;
+            }
+            if let Some(op) = &self.operation {
+                for value in [&op.operation_id, &op.owner_id, &op.process_nonce, &op.source_id, &op.consent_id] { opaque(value)?; }
+                for value in [&op.endpoint_generation, &op.source_generation, &op.consent_generation] { decimal(value, true)?; }
+                decimal(&op.forget_epoch, false)?;
+                require(decimal(&op.admitted_wall_time, false)? <= i64::MAX as u64)?;
+            }
+            if let Some(t) = &self.last_terminal {
+                opaque(&t.operation_id)?;
+                require(t.status == "committed" && t.successor_auth_witness.is_some() && t.successor_auth_state_commitment.is_some())?;
+                t.successor_auth_witness.as_ref().ok_or_else(invalid)?.validate()?;
+                opaque(t.successor_auth_state_commitment.as_ref().ok_or_else(invalid)?)?;
+            }
+            require(decimal(&self.sequence, false)? != 0 || (self.phase == Phase::Clean && self.last_terminal.is_none()))
+        }
+
+        fn advance(&mut self) -> io::Result<()> {
+            self.sequence = decimal(&self.sequence, false)?.checked_add(1).ok_or_else(invalid)?.to_string(); Ok(())
+        }
+    }
+
+    fn envelope(key: &[u8], journal: &Journal) -> io::Result<Zeroizing<Vec<u8>>> {
+        let raw = serialize(journal, PAYLOAD_LIMIT)?;
+        let length = raw.len().to_string();
+        let mut input = Zeroizing::new(Vec::new()); input.extend_from_slice(length.as_bytes()); input.push(b'\n'); input.extend_from_slice(&raw);
+        let proof = mac(key, MAC_DOMAIN, &input)?;
+        let mut out = Zeroizing::new(Vec::new()); out.extend_from_slice(MAGIC.as_bytes()); out.extend_from_slice(length.as_bytes()); out.push(b'\n'); out.extend_from_slice(proof.as_bytes()); out.push(b'\n'); out.extend_from_slice(&raw);
+        require(out.len() <= JOURNAL_LIMIT)?; Ok(out)
+    }
+
+    fn parse_envelope(key: &[u8], raw: &[u8], expected: &Enrollment) -> io::Result<Journal> {
+        require(raw.len() <= JOURNAL_LIMIT && raw.starts_with(MAGIC.as_bytes()))?;
+        let tail = &raw[MAGIC.len()..];
+        let split = tail.iter().position(|c| *c == b'\n').ok_or_else(invalid)?;
+        let length = std::str::from_utf8(&tail[..split]).map_err(|_| invalid())?;
+        let bytes = decimal(length, false)?;
+        require(bytes > 0 && bytes <= PAYLOAD_LIMIT as u64)?;
+        let tail = &tail[split + 1..];
+        require(tail.len() >= 65 && tail[64] == b'\n' && tail.len() - 65 == bytes as usize)?;
+        let supplied = decode(&tail[..64])?;
+        let payload = &tail[65..];
+        let mut h = Hmac::<Sha256>::new_from_slice(key).map_err(|_| invalid())?;
+        h.update(MAC_DOMAIN); h.update(length.as_bytes()); h.update(b"\n"); h.update(payload);
+        h.verify_slice(&supplied).map_err(|_| invalid())?;
+        let journal: Journal = serde_json::from_slice(payload).map_err(|_| invalid())?;
+        journal.validate(expected)?; Ok(journal)
+    }
+
+    fn identity(key: &[u8], raw: &[u8]) -> io::Result<String> {
+        let mut auth: AuthDotJson = serde_json::from_slice(raw).map_err(|_| invalid())?;
+        let result = (|| {
+            require(auth.resolved_mode() == AuthMode::Chatgpt && auth.openai_api_key.is_none() && auth.agent_identity.is_none() && auth.personal_access_token.is_none() && auth.bedrock_api_key.is_none() && auth.bedrock_access_keys.is_none())?;
+            let token = auth.tokens.as_ref().ok_or_else(invalid)?;
+            let user = token.id_token.chatgpt_user_id.as_ref().ok_or_else(invalid)?;
+            let workspace = token.id_token.chatgpt_account_id.as_ref().ok_or_else(invalid)?;
+            require(!user.trim().is_empty() && !workspace.trim().is_empty() && !token.access_token.is_empty() && !token.refresh_token.is_empty() && token.account_id.as_ref().is_none_or(|id| id == workspace))?;
+            let mut private = Zeroizing::new(Vec::new());
+            private.extend_from_slice(&(user.len() as u64).to_be_bytes()); private.extend_from_slice(user.as_bytes());
+            private.extend_from_slice(&(workspace.len() as u64).to_be_bytes()); private.extend_from_slice(workspace.as_bytes());
+            mac(key, b"omux-native-managed-file-identity-v1\n", &private)
+        })();
+        // The additional supported-mode parser copies are private and scrubbed;
+        // raw original/successor buffers and capability key also zeroize on drop.
+        if let Some(token) = &mut auth.tokens {
+            token.access_token.zeroize(); token.refresh_token.zeroize();
+            token.id_token.raw_jwt.zeroize();
+            if let Some(value) = &mut token.id_token.email { value.zeroize(); }
+            if let Some(value) = &mut token.id_token.chatgpt_user_id { value.zeroize(); }
+            if let Some(value) = &mut token.id_token.chatgpt_account_id { value.zeroize(); }
+            if let Some(value) = &mut token.account_id { value.zeroize(); }
+        }
+        if let Some(value) = &mut auth.openai_api_key { value.zeroize(); }
+        result
+    }
+
+    pub(in crate::auth) struct ManagedFileProfile {
+        home_path: PathBuf,
+        home: File,
+        writer: File,
+        lock: File,
+        capability: File,
+        home_identity: Witness,
+        writer_identity: Witness,
+        lock_identity: Witness,
+        capability_identity: Witness,
+        key: Zeroizing<[u8; 32]>,
+        enrollment: Enrollment,
+        identity_commitment: String,
+        #[cfg(test)]
+        fault: std::sync::atomic::AtomicU8,
+    }
+
+    impl ManagedFileProfile {
+        fn recheck(&self) -> io::Result<()> {
+            let named_home = directory(&self.home_path)?;
+            require(self.home_identity.same_directory(&Witness::from(&self.home.metadata()?)) && self.home_identity.same_directory(&Witness::from(&named_home.metadata()?)))?;
+            let named_writer = open(self.home.as_raw_fd(), OsStr::new(DIRECTORY), libc::O_RDONLY | libc::O_DIRECTORY)?;
+            require(self.writer_identity.same_directory(&Witness::from(&self.writer.metadata()?)) && self.writer_identity.same_directory(&Witness::from(&named_writer.metadata()?)))?;
+            let named_lock = leaf(&self.writer, LOCK, libc::O_RDWR, 0)?;
+            let (_, key_identity, bytes) = read_leaf(&self.writer, KEY, 64)?;
+            require(self.lock_identity == Witness::from(&self.lock.metadata()?) && self.lock_identity == Witness::from(&named_lock.metadata()?) && self.capability_identity == Witness::from(&self.capability.metadata()?) && self.capability_identity == key_identity && decode(&bytes)? == *self.key)
+        }
+
+        fn recheck_physical(&self) -> io::Result<()> {
+            // No raw journal/auth/key parsing after the final full read. Check
+            // actual retained and named descriptors under the original cutoff.
+            let named_home = directory(&self.home_path)?;
+            require(self.home_identity.same_directory(&Witness::from(&self.home.metadata()?)) && self.home_identity.same_directory(&Witness::from(&named_home.metadata()?)))?;
+            let named_writer = open(self.home.as_raw_fd(), OsStr::new(DIRECTORY), libc::O_RDONLY | libc::O_DIRECTORY)?;
+            require(self.writer_identity.same_directory(&Witness::from(&self.writer.metadata()?)) && self.writer_identity.same_directory(&Witness::from(&named_writer.metadata()?)))?;
+            let named_lock = leaf(&self.writer, LOCK, libc::O_RDWR, 0)?;
+            let named_key = leaf(&self.writer, KEY, libc::O_RDONLY, 64)?;
+            require(self.lock_identity == Witness::from(&self.lock.metadata()?) && self.lock_identity == Witness::from(&named_lock.metadata()?)
+                && self.capability_identity == Witness::from(&self.capability.metadata()?) && self.capability_identity == Witness::from(&named_key.metadata()?))
+        }
+
+        fn recheck_terminal(&self, journal: &Journal) -> io::Result<()> {
+            if journal.phase == Phase::Clean {
+                if let Some(terminal) = &journal.last_terminal {
+                    let (_, witness, bytes) = read_leaf(&self.home, AUTH, AUTH_LIMIT)?;
