+//! Closed request routes. This consumes daemon authority; it creates no OAuth issuer.
+use codex_api::ResponsesApiRequest;
+use codex_model_provider_info::{ModelProviderInfo, WireApi};
+use codex_protocol::models::ResponseItem;
+use serde_json::Value;
+use std::io;
+
+pub(crate) const SIWC_PROFILE: &str = "openai_siwc_responses_v1";
+pub(crate) const SIWC_PROVIDER: &str = "openai_siwc";
+pub(crate) const SIWC_ISSUER: &str = "https://auth.openai.com";
+pub(crate) const SIWC_AUDIENCE: &str = "https://api.openai.com/v1";
+pub(crate) const SIWC_AUTH_MODE: &str = "openai_siwc_access_token";
+const SIWC_NAME: &str = "Omux SIWC Responses";
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(crate) enum RequestProfile { NativeChatgpt, SiwcResponses }
+fn refused() -> io::Error { io::Error::other("broker request profile is unsupported or mismatched") }
+impl RequestProfile {
+    pub(crate) fn for_provider(info: &ModelProviderInfo) -> io::Result<Self> {
+        if info.name == SIWC_NAME {
+            if info.base_url.as_deref() != Some(SIWC_AUDIENCE)
+                || !matches!(info.wire_api, WireApi::Responses)
+                || info.requires_openai_auth || info.supports_websockets || info.supports_standalone_web_search
+                || info.env_key.is_some() || info.experimental_bearer_token.is_some()
+                || info.auth.is_some() || info.gateway_oauth.is_some() || info.aws.is_some()
+                || info.query_params.is_some() || info.http_headers.is_some() || info.env_http_headers.is_some()
+                || info.model_catalog_url.is_some()
+            { return Err(refused()); }
+            return Ok(Self::SiwcResponses);
+        }
+        if !info.is_openai() { return Err(refused()); }
+        let provider = info.to_api_provider(Some(codex_protocol::auth::AuthMode::ChatgptAuthTokens))
+            .map_err(|_| refused())?;
+        if provider.base_url.trim_end_matches('/') != crate::auth_broker::ENDPOINT || provider.query_params.is_some() {
+            return Err(refused());
+        }
+        Ok(Self::NativeChatgpt)
+    }
+    pub(crate) fn audience(self) -> &'static str {
+        match self { Self::NativeChatgpt => crate::auth_broker::ISSUER, Self::SiwcResponses => SIWC_AUDIENCE }
+    }
+    pub(crate) fn provider(self) -> &'static str {
+        match self { Self::NativeChatgpt => "codex", Self::SiwcResponses => SIWC_PROVIDER }
+    }
+    pub(crate) fn auth_mode(self) -> Option<codex_protocol::auth::AuthMode> {
+        match self { Self::NativeChatgpt => Some(codex_protocol::auth::AuthMode::ChatgptAuthTokens), Self::SiwcResponses => None }
+    }
+}
+
+// Reject unsupported tools rather than silently changing native tool semantics.
+fn tools_supported(tools: &[Value], depth: usize) -> io::Result<()> {
+    if depth > 8 { return Err(refused()); }
+    for tool in tools {
+        match tool.get("type").and_then(Value::as_str) {
+            Some("function" | "custom") => {},
+            Some("namespace") => tools_supported(tool.get("tools").and_then(Value::as_array).ok_or_else(refused)?, depth + 1)?,
+            _ => return Err(refused()),
+        }
+    }
+    Ok(())
+}
+
+/// Use the documented additional_tools representation. No native transcript is mutated.
+/// HTTP sends full input; unsupported history remains in place and is explicitly refused.
+pub(crate) fn prepare_siwc_request(request: &mut ResponsesApiRequest) -> io::Result<()> {
+    if request.store || !request.stream || request.access_programs.is_some() { return Err(refused()); }
+    let raw = serde_json::to_value(&request.input).map_err(|_| refused())?;
+    for item in raw.as_array().ok_or_else(refused)? {
+        match item.get("type").and_then(Value::as_str) {
+            Some("message") => {
+                if !matches!(item.get("role").and_then(Value::as_str), Some("user" | "assistant" | "developer")) { return Err(refused()); }
+                for content in item.get("content").and_then(Value::as_array).ok_or_else(refused)? {
+                    if !matches!(content.get("type").and_then(Value::as_str), Some("input_text" | "output_text" | "input_image" | "input_file")) { return Err(refused()); }
+                }
+            },
+            Some("additional_tools") => tools_supported(item.get("tools").and_then(Value::as_array).ok_or_else(refused)?, 0)?,
+            Some("function_call_output" | "custom_tool_call_output") => {
+                let output = item.get("output").ok_or_else(refused)?;
+                if let Some(content) = output.as_array() {
+                    for part in content {
+                        if !matches!(part.get("type").and_then(Value::as_str), Some("input_text" | "input_image")) {
+                            return Err(refused());
+                        }
+                    }
+                } else if !output.is_string() { return Err(refused()); }
+            },
+            Some("reasoning" | "function_call" | "custom_tool_call") => {},
+            _ => return Err(refused()),
+        }
+    }
+    if let Some(tools) = &request.tools {
+        let value = serde_json::to_value(tools).map_err(|_| refused())?;
+        let tools = value.as_array().ok_or_else(refused)?.clone();
+        tools_supported(&tools, 0)?;
+        if !tools.is_empty() {
+            request.input.insert(0, ResponseItem::AdditionalTools { id: None, role: "developer".to_owned(), tools });
+        }
+        request.tools = None;
+    }
+    request.client_metadata = None;
+    request.stream_options = None;
+    // These unsupported fields are not representable in the pinned request type.
+    // Fail closed if a later maintained request type starts serializing one.
+    let body = serde_json::to_value(&*request).map_err(|_| refused())?;
+    for name in ["background", "conversation", "max_output_tokens", "max_tool_calls", "metadata", "moderation", "multi_agent", "prompt", "prompt_cache_retention", "safety_identifier", "temperature", "top_logprobs", "top_p", "truncation", "user", "previous_response_id"] {
+        if body.get(name).is_some() { return Err(refused()); }
+    }
+    Ok(())
+}
