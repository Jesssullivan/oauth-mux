+#[test]
+fn actual_request_keeps_full_history_and_moves_only_supported_tools_to_additional_tools() {
+    let mut request = request();
+    let original = request.input.clone();
+    let raw: std::sync::Arc<serde_json::value::RawValue> = serde_json::value::RawValue::from_string(
+        r#"[{"type":"function","name":"fixture_tool","parameters":{"type":"object","properties":{}}},{"type":"custom","name":"fixture_custom","format":{"type":"text"}}]"#.to_owned()).unwrap().into();
+    request.tools=Some(raw.into());
+    request.client_metadata=Some(std::collections::HashMap::from([("synthetic".to_owned(),"metadata".to_owned())]));
+    prepare_siwc_request(&mut request).unwrap();
+    assert_eq!(&request.input[1..], original.as_slice());
+    assert!(matches!(&request.input[0],ResponseItem::AdditionalTools { id:None,role,tools } if role=="developer" && tools.len()==2));
+    let body=serde_json::to_value(&request).unwrap();
+    assert_eq!(body["store"],false); assert_eq!(body["stream"],true);
+    assert!(body.get("tools").is_none() && body.get("client_metadata").is_none() && body.get("previous_response_id").is_none());
+    assert_eq!(body["instructions"],"synthetic developer instructions");
+    prepare_siwc_request(&mut request).unwrap();
+    assert_eq!(request.input.len(),2);
+}
