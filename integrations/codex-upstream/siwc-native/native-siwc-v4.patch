+    assert!(RequestProfile::for_provider(&native).unwrap() == RequestProfile::NativeChatgpt);
+    assert_eq!(RequestProfile::NativeChatgpt.audience(),crate::auth_broker::ISSUER);
+    assert_eq!(RequestProfile::SiwcResponses.audience(),SIWC_AUDIENCE);
+    assert_eq!(RequestProfile::SiwcResponses.provider(),"openai_siwc");
+    assert!(RequestProfile::SiwcResponses.auth_mode().is_none());
+}
