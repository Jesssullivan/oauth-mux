+fn tool_output(custom: bool, payload: codex_protocol::models::FunctionCallOutputPayload) -> ResponseItem {
+    if custom {
+        ResponseItem::CustomToolCallOutput { id:None,call_id:"synthetic-call".into(),name:None,
+            output:payload,internal_chat_message_metadata_passthrough:None }
+    } else {
+        ResponseItem::FunctionCallOutput { id:None,call_id:Some("synthetic-call".into()),name:None,namespace:None,
+            output:payload,internal_chat_message_metadata_passthrough:None }
+    }
+}
