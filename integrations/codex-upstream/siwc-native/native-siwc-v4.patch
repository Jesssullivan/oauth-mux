+#[test]
+fn actual_typed_function_and_custom_audio_or_encrypted_outputs_refuse_before_any_mutation() {
+    use codex_protocol::models::{FunctionCallOutputContentItem,FunctionCallOutputPayload};
+    for custom in [false,true] {
+        for content in [FunctionCallOutputContentItem::InputAudio { audio_url:"data:audio/wav;base64,synthetic".into() },
+            FunctionCallOutputContentItem::EncryptedContent { encrypted_content:"synthetic-opaque-output".into() }]
+        {
+            let mut request=request();
+            request.input.push(tool_output(custom,FunctionCallOutputPayload::from_content_items(vec![content])));
+            let original=request.clone();
+            assert!(prepare_siwc_request(&mut request).is_err());
+            assert_eq!(request,original);
+        }
+    }
+}
