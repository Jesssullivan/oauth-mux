+#[test]
+fn unsupported_native_history_and_hosted_tools_are_refused_without_history_rewrite() {
+    for item in [
+        json!({"type":"message","role":"system","content":[{"type":"input_text","text":"synthetic"}]}),
+        json!({"type":"additional_tools","role":"developer","tools":[{"type":"tool_search"}]}),
+        json!({"type":"additional_tools","role":"developer","tools":[{"type":"namespace","name":"synthetic","tools":[{"type":"image_generation"}]}]}),
+    ] {
+        let mut request=request(); request.input=vec![serde_json::from_value(item).unwrap()];
+        let original=request.input.clone();
+        assert!(prepare_siwc_request(&mut request).is_err()); assert_eq!(request.input,original);
+    }
+    for (store,stream) in [(true,true),(false,false)] {
+        let mut request=request();request.store=store;request.stream=stream;
+        assert!(prepare_siwc_request(&mut request).is_err());
+    }
+}
