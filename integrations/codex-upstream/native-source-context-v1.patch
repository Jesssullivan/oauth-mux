+//! Private native source-context declaration; no credential acquisition.
+use schemars::JsonSchema;
+use serde::{Deserialize, Serialize};
+use ts_rs::TS;
+
+#[derive(Debug, Clone, Deserialize, Serialize, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(export_to = "v2/")]
+pub struct OmuxOwnerSourceContextParams {
+    pub protocol_version: u32,
+    pub owner_id: String,
+    pub process_nonce: String,
+    pub endpoint_generation: String,
+}
+
+#[derive(Debug, Clone, Deserialize, Serialize, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(export_to = "v2/")]
+pub enum OmuxOwnerSourceContextStatus { Available, Unavailable }
+
+#[derive(Debug, Clone, Deserialize, Serialize, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(export_to = "v2/")]
+pub struct OmuxOwnerSourceContextResponse {
+    pub protocol_version: u32,
+    pub owner_id: String,
+    pub process_nonce: String,
+    pub endpoint_generation: String,
+    pub status: OmuxOwnerSourceContextStatus,
+    pub source_context_id: Option<String>,
+    pub source_context_generation: Option<String>,
+    pub store_present: Option<bool>,
+    pub credential_acquisition_authorized: bool,
+}
