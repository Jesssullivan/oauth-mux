{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omux.dev/schemas/managed-harness-jsonrpc-v2.schema.json",
  "title": "omux managed-harness JSON-RPC surface v2",
  "description": "Declaration-only compatibility contract. Every listed method is unimplemented until adapter proof lands.",
  "oneOf": [
    {
      "$ref": "#/$defs/request_surface_info"
    },
    {
      "$ref": "#/$defs/request_harness_preflight"
    },
    {
      "$ref": "#/$defs/request_session_launch"
    },
    {
      "$ref": "#/$defs/request_route_lease_snapshot"
    },
    {
      "$ref": "#/$defs/request_session_transition"
    },
    {
      "$ref": "#/$defs/request_repair_handoff"
    },
    {
      "$ref": "#/$defs/request_session_teardown"
    },
    {
      "$ref": "#/$defs/success_response"
    },
    {
      "$ref": "#/$defs/not_implemented_response"
    },
    {
      "$ref": "#/$defs/unknown_method_response"
    }
  ],
  "x-omux-surface": {
    "surface_version": 2,
    "protocol_name": "managed-harness-jsonrpc",
    "status": "planned_unshipped",
    "exact_model_required": true,
    "max_upstream_attempts": 2,
    "methods": [
      {
        "name": "surface/info",
        "lifecycle_phase": "discovery",
        "implementation_status": "not_implemented",
        "request_schema": "#/$defs/request_surface_info",
        "result_schema": "#/$defs/result_surface_info",
        "required_params": [],
        "required_result_fields": [
          "surface_version",
          "status",
          "methods"
        ],
        "unknown_fields": "tolerated_except_sensitive_names"
      },
      {
        "name": "harness/preflight",
        "lifecycle_phase": "preflight",
        "implementation_status": "not_implemented",
        "request_schema": "#/$defs/request_harness_preflight",
        "result_schema": "#/$defs/result_harness_preflight",
        "required_params": [
          "harness",
          "model_demand"
        ],
        "required_result_fields": [
          "ready",
          "harness_handle",
          "reasons"
        ],
        "unknown_fields": "tolerated_except_sensitive_names"
      },
      {
        "name": "session/launch",
        "lifecycle_phase": "launch",
        "implementation_status": "not_implemented",
        "request_schema": "#/$defs/request_session_launch",
        "result_schema": "#/$defs/result_session_launch",
        "required_params": [
          "harness_handle",
          "model_demand"
        ],
        "required_result_fields": [
          "session_handle",
          "route_handle",
          "state"
        ],
        "unknown_fields": "tolerated_except_sensitive_names"
      },
      {
        "name": "route/lease_snapshot",
        "lifecycle_phase": "observe",
        "implementation_status": "not_implemented",
        "request_schema": "#/$defs/request_route_lease_snapshot",
        "result_schema": "#/$defs/result_route_lease_snapshot",
        "required_params": [
          "session_handle"
        ],
        "required_result_fields": [
          "session_handle",
          "leases",
          "observed_at_ms"
        ],
        "unknown_fields": "tolerated_except_sensitive_names"
      },
      {
        "name": "session/transition",
        "lifecycle_phase": "transition",
        "implementation_status": "not_implemented",
        "request_schema": "#/$defs/request_session_transition",
        "result_schema": "#/$defs/result_session_transition",
        "required_params": [
          "session_handle",
          "model_demand",
          "proxy_attempts"
        ],
        "required_result_fields": [
          "state",
          "selected_route_handle",
          "action_required"
        ],
        "unknown_fields": "tolerated_except_sensitive_names"
      },
      {
        "name": "repair/handoff",
        "lifecycle_phase": "repair",
        "implementation_status": "not_implemented",
        "request_schema": "#/$defs/request_repair_handoff",
        "result_schema": "#/$defs/result_repair_handoff",
        "required_params": [
          "session_handle",
          "reason"
        ],
        "required_result_fields": [
          "handoff_handle",
          "action"
        ],
        "unknown_fields": "tolerated_except_sensitive_names"
      },
      {
        "name": "session/teardown",
        "lifecycle_phase": "teardown",
        "implementation_status": "not_implemented",
        "request_schema": "#/$defs/request_session_teardown",
        "result_schema": "#/$defs/result_session_teardown",
        "required_params": [
          "session_handle"
        ],
        "required_result_fields": [
          "complete"
        ],
        "unknown_fields": "tolerated_except_sensitive_names"
      }
    ]
