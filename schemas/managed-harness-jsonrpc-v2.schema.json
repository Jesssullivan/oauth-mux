        },
        "outcome": {
          "type": "string",
          "enum": [
            "retained",
            "switched",
            "refused",
            "unproven"
          ]
        },
        "response_started": {
          "type": "boolean"
        }
      }
    },
    "proxy_attempts": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/proxy_attempt"
      }
    },
    "method_statuses": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
