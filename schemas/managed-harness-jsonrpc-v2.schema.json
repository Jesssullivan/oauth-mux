  "$defs": {
    "safe_extension_value": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_extension_value"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$",
            "not": {
              "pattern": "(credential|token|authorization|cookie|env|argv|prompt|response_body|raw_account)"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/safe_extension_value"
          }
        }
      ]
    },
    "opaque_handle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "handle_or_null": {
      "oneOf": [
        {
          "$ref": "#/$defs/opaque_handle"
        },
        {
          "type": "null"
        }
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "redacted_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "boolean": {
      "type": "boolean"
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 1024
      }
    },
    "open_object": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/safe_extension_value"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$",
        "not": {
          "pattern": "(credential|token|authorization|cookie|env|argv|prompt|response_body|raw_account)"
        }
      }
    },
    "open_object_array": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/safe_extension_value"
        },
        "propertyNames": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "not": {
            "pattern": "(credential|token|authorization|cookie|env|argv|prompt|response_body|raw_account)"
          }
        }
      }
    },
    "transition_state": {
      "type": "string",
      "enum": [
        "ready",
        "running",
        "retained",
        "switched",
        "refused",
        "action_required",
        "teardown_complete"
      ]
    },
    "model_demand": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/safe_extension_value"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$",
        "not": {
          "pattern": "(credential|token|authorization|cookie|env|argv|prompt|response_body|raw_account)"
        }
      },
      "required": [
        "model",
        "preservation"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "preservation": {
          "type": "string",
          "const": "exact"
        }
      }
    },
    "proxy_attempt": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/safe_extension_value"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$",
        "not": {
          "pattern": "(credential|token|authorization|cookie|env|argv|prompt|response_body|raw_account)"
        }
      },
      "required": [
        "ordinal",
        "account_handle",
        "route_handle",
        "model_demand",
        "outcome",
        "response_started"
