# Local sandboxed actions. RBE endpoints and credentials are runtime inputs.
common --enable_bzlmod
common --noenable_workspace
common --registry=https://bcr.bazel.build
build --spawn_strategy=sandboxed
build --incompatible_strict_action_env
build --show_timestamps
test --test_output=errors
test --test_summary=detailed
test --test_env=TZ=UTC
# Namespace UID remapping makes host-owned ancestors appear as overflow UID.
# Runtime custody fixtures need their real ownership; compilation stays in the
# namespace sandbox, and tests retain Bazel's declared-input sandbox/runfiles.
test --strategy=TestRunner=processwrapper-sandbox
build --@rules_zig//zig/settings:use_standalone_translate_c

# Opt-in REAPI execution. Operator configuration supplies endpoints/auth and
# scheduler routing. Never fall back to executing Darwin actions on the client.
build:reapi --spawn_strategy=remote
build:reapi --remote_local_fallback=false
build:reapi --remote_download_outputs=all
test:reapi --strategy=TestRunner=remote
build:darwin-reapi --config=reapi
build:darwin-reapi --platforms=//tools:darwin_aarch64
build:darwin-reapi --extra_execution_platforms=@omux_nix//:execution_platform
build:darwin-reapi --jobs=1

# Fresh execution receipts must distinguish execution from cache acceptance.
build:reapi-proof --remote_accept_cached=false
