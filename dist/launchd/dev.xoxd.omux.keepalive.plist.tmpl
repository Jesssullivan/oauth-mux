<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  oauth-mux keepalive LaunchAgent template (TIN-1830).
  Rendered by scripts/keepalive-service.sh install; @OMUX_BIN@ and
  @OMUX_LOG_DIR@ are substituted with absolute paths at install time.
  Guardrail: no credential material may ever appear in this file or in
  EnvironmentVariables - the binary reads credential stores live at runtime.
  The loop is bounded by design (100000 ticks, sleep capped at 60s);
  launchd owns residency via KeepAlive and restarts it on any exit.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.xoxd.omux.keepalive</string>
  <key>ProgramArguments</key>
  <array>
    <string>@OMUX_BIN@</string>
    <string>keepalive</string>
    <string>--iterations</string>
    <string>100000</string>
    <string>--interval-ms</string>
    <string>60000</string>
    <string>--json</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>300</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NO_COLOR</key>
    <string>1</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>@OMUX_LOG_DIR@/keepalive.out.log</string>
  <key>StandardErrorPath</key>
  <string>@OMUX_LOG_DIR@/keepalive.err.log</string>
</dict>
</plist>
