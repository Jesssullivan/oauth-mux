{
	"$schema": "https://raw.githubusercontent.com/tinyland-inc/site.scaffold/main/docs/schemas/tinyland-repo-manifest.schema.json",
	"schema_version": 1,
	"repo": {
		"name": "oauth-mux",
		"github": "Jesssullivan/oauth-mux",
		"description": "Race-safe, embeddable, resumable multi-harness OAuth broker (omux). Pure Zig; brokers/multiplexes OAuth so agent harnesses stay afloat across accounts.",
		"linear": {
			"issue": "TIN-2105"
		}
	},
	"taxonomy": {
		"primary_role": "org-utility",
		"layers": ["org-wide-repo-contract", "bazel-package-cache-rbe"]
	},
	"enrollment": {
		"forgeScope": "Jesssullivan",
		"operatorOverlay": "jesssullivan-infra",
		"executionPool": "tinyland-nix",
		"substrateMode": "shared-cache-backed"
	},
	"contracts": {
		"agent_contract": "AGENTS.md",
		"just": "justfile",
		"nix": "flake.nix",
		"github_actions": ".github/workflows",
		"secrets_scan": "gitleaks",
		"conformance": "just check"
	},
	"boundaries": {
		"owns_runtime_backend": true,
		"owns_auth": true,
		"owns_payments": false,
		"owns_activitypub_delivery": false,
		"owns_live_broker_fetch": true,
		"owns_static_projection_ingest": false,
		"owns_gitops_apply": false,
		"owns_cloudflare_mutation": false,
		"owns_bazel_module_authority": false
	},
	"authorities": {
		"content_authority": "tinyland-inc/omux.xoxd.ai",
		"gitops_receiver": "tinyland-inc/blahaj",
		"ci_templates": "tinyland-inc/ci-templates",
		"cache_rbe_authority": "tinyland-inc/GloriousFlywheel",
		"package_registry": "tinyland-inc/bazel-registry"
	},
	"supply_chain": {
		"sbom": {
			"status": "planned",
			"formats": [],
			"notes": "No SBOM recipe exists in this repo yet (no `just sbom`; pure-Zig binary, zero external Zig dependencies). Generation lands with the ci-templates migration tracked in docs/reference/tinyland-repo-manifest-notes.md; formats stay empty until a recipe picks them."
		}
	}
}
