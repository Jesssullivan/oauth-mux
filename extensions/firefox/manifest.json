{
  "manifest_version": 3,
  "name": "Omux browser sources",
  "version": "0.2.0",
  "description": "Connect explicitly authorized browser account sources to the local Omux daemon.",
  "permissions": ["nativeMessaging", "storage", "activeTab"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*", "https://github.com/*"],
  "background": { "scripts": ["shared/background.mjs"], "type": "module" },
  "action": { "default_title": "Omux browser sources", "default_popup": "shared/popup.html" },
  "browser_specific_settings": { "gecko": { "id": "browser-sources@omux.xoxd.ai", "strict_min_version": "128.0", "data_collection_permissions": { "required": ["authenticationInfo", "websiteContent"] } } },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'" }
}
