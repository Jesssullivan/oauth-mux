{
  "version": 1,
  "defaults": {
    "provider": "claude",
    "strategy": "health-weighted",
    "shell": "fish"
  },
  "providers": {
    "claude": {
      "kind": "claude",
      "accounts": {
        "work": {
          "priority": 10,
          "config_dir": "~/.claude",
          "secret": {
            "backend": "file",
            "path": "~/.claude/.credentials.json"
          },
          "tags": ["oauth", "claude"]
        }
      }
    }
  },
  "profiles": {
    "claude": {
      "providers": ["claude:work#auth-status"],
      "strategy": "health-weighted",
      "affinity_ttl_minutes": 20
    }
  },
  "strategies": {
    "health-weighted": {
      "kind": "health-weighted",
      "rate_limit_penalty": -10,
      "failure_penalty": -20,
      "success_bonus": 1
    }
  }
}
