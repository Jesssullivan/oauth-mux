{
  "version": 1,
  "defaults": {
    "provider": "figma-plan",
    "strategy": "health-weighted",
    "shell": "fish"
  },
  "providers": {
    "figma-plan": {
      "kind": "figma",
      "accounts": {
        "work": {
          "priority": 10,
          "secret": {
            "backend": "env",
            "variable": "OMUX_FIGMA_PLAN_TOKEN"
          },
          "tags": ["plan-token", "figma"]
        }
      }
    }
  },
  "profiles": {
    "figma-plan": {
      "providers": ["figma-plan:work#file-metadata-plan"],
      "strategy": "health-weighted",
      "affinity_ttl_minutes": 20
    }
  },
  "strategies": {
    "health-weighted": {
      "kind": "health-weighted",
      "rate_limit_penalty": -10,
      "failure_penalty": -20,
      "success_bonus": 1
    }
  }
}
